# Variables d'environnement du site (à recopier dans .env.local en local,
# et dans Vercel → Settings → Environment Variables pour la production).
# Ce fichier est versionné : n'y mettez JAMAIS de vraie valeur.
# Convention : les clés d'API et secrets sont en minuscules.

# --- Formulaire de contact -----------------------------------------------------
# Sans Supabase ni Resend (développement local), la demande est affichée dans la
# console et le formulaire répond « succès ». En production, il faut au moins
# l'un des deux (idéalement les deux : aucune demande perdue).

# Supabase : adresse du projet (Project Settings → API). Sans valeur, le code
# utilise le projet de production (https://tyghpfqyppiughrknuit.supabase.co).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé publique « publishable » (Project Settings → API keys), envoyée au
# navigateur : elle n'a que les droits de la RLS. Sans valeur, le code utilise
# celle du projet de production (lib/supabase/config.ts).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Clé service_role (Project Settings → API keys). Serveur uniquement, contourne la RLS.
supabase_service_role_key=

# Resend : clé d'API (droit « Sending access » suffit).
resend_api_key=
# Qui reçoit les demandes (défaut : cedric@spiceevents.fr).
contact_destinataire=cedric@spiceevents.fr
# Expéditeur des emails : le domaine doit être vérifié dans Resend (DNS SPF/DKIM).
contact_expediteur=Spice Events <contact@spiceevents.fr>

# Secret pour les empreintes HMAC des adresses IP (limite de 5 demandes par
# heure) ET des tentatives de connexion au back office /admin (IP + compte,
# 15 minutes). Générer avec : openssl rand -hex 32 — le changer remet les
# compteurs à zéro. Avec la clé service_role mais sans ce secret, la connexion
# au back office est refusée par prudence : il doit être défini en production.
contact_secret_ip=
