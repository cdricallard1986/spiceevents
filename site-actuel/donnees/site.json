   "text1": {
    "type": "RichText",
    "id": "f_68ee7ed6-e0ff-441e-82cb-1c9cee100681",
    "defaultValue": false,
    "alignment": null,
    "value": "<div class=\"s-rich-text-wrapper\" style=\"display: block; \"><p>Qui sommes nous ?</p><p> </p><p class=\" #(className)\"><span style=\"color: #a67330;\"><a style=\"color: #a67330;\" href=\"https://www.spiceevents.fr/#1\" data-type=\"\" target=\"_self\">Accueil</a></span></p><p class=\" #(className)\"><span style=\"color: #a67330;\"><a style=\"color: #a67330;\" href=\"https://www.spiceevents.fr/#2\" data-type=\"\" target=\"_blank\">Pourquoi nous</a></span><span style=\"color: #a67330;\"><a style=\"color: #a67330;\" href=\"http://spiceevents.strikingly.com/#4\" data-type=\"\" target=\"_blank\"> choisir ?</a></span></p><p class=\" #(className)\"><span style=\"color: #a67330;\"><a style=\"color: #a67330;\" href=\"https://www.spiceevents.fr/#6\" data-type=\"\" target=\"_self\">Nos prestations </a></span></p><p class=\" #(className)\"><span style=\"color: #a67330;\"><a style=\"color: #a67330;\" href=\"https://www.spiceevents.fr/#7\" data-type=\"\" target=\"_self\">Pourquoi nous ? </a></span></p><p class=\" #(className)\"><span style=\"color: #a67330;\"><a style=\"color: #a67330;\" href=\"https://www.spiceevents.fr/#8\" data-type=\"\" target=\"_self\">Nos </a></span><span style=\"color: #a67330;\">services</span></p><p class=\" #(className)\"><span style=\"color: #a67330;\"><a style=\"color: #a67330;\" href=\"https://www.spiceevents.fr/#9\" data-type=\"\" target=\"_self\">Quelques photos </a></span></p></div>",
    "backupValue": null,
    "version": 1,
    "defaultDataProcessed": true
   },
   "text2": {
    "type": "RichText",
    "id": "f_ebc7679f-8ff1-4507-a287-a9dbcf750ef9",
    "defaultValue": false,
    "alignment": null,
    "value": "<p><strong>Nos Prestations</strong></p><p>&nbsp;</p><p><a target=\"_self\" href=\"http://www.spiceevents.fr/mariage-exception-paris\"><span class=\"#(className)\" style=\"color:#a67330;\">W</span></a><a target=\"_self\" href=\"http://www.spiceevents.fr/mariage-exception-paris\"><span class=\"#(className)\" style=\"color:#a67330;\">edding</span></a></p><p><a target=\"_self\" href=\"http://www.spiceevents.fr/private-party-formules\"><span class=\"#(className)\" style=\"color:#a67330;\">Private Party</span></a></p><p><a target=\"_self\" href=\"http://www.spiceevents.fr/formule-soiree-corporate\"><span class=\"#(className)\" style=\"color:#a67330;\">Corporate</span></a></p><p><a target=\"_self\" href=\"http://www.spiceevents.fr/nos-dj-d-exception\"><span class=\"#(className)\" style=\"color:#a67330;\">N</span></a><a target=\"_self\" href=\"http://www.spiceevents.fr/nos-dj-d-exception\"><span class=\"#(className)\" style=\"color:#a67330;\">os DJ d'exception</span></a></p><p><span class=\"#(className)\" style=\"color:#555555;\"><a target=\"_self\" href=\"http://www.spiceevents.fr/des-evenements-plus-green\"><span class=\"#(className)\" style=\"color:#a67330;\">Des événements plus green</span></a></span></p><p><a target=\"_self\" href=\"http://www.spiceevents.fr/le-bar-a-vinyles\"><span class=\"#(className)\" style=\"color:#a67330;\">Le bar à vinyles </span></a></p><p><a target=\"_self\" href=\"http://www.spiceevents.fr/le-photobooth\"><span class=\"#(className)\" style=\"color:#a67330;\">Le PhotoBooth</span></a></p><p>&nbsp;</p><p><a target=\"_self\" href=\"http://www.spiceevents.fr/materiel\"><span class=\"#(className)\" style=\"color:#140e06;\"><strong>Matériel</strong></span></a></p>",
    "backupValue": null,
    "version": 1
   },
   "text3": {
    "type": "RichText",
    "id": "f_74ec2c46-d8af-4cb0-864f-e2998f189740",
    "defaultValue": false,
    "alignment": null,
    "value": "<div class=\"s-rich-text-wrapper\"><p class=\" #(className) s-rich-text-wrapper\"><span style=\"color: var(--s-pre-color10);\"><a style=\"color: var(--s-pre-color10);\" href=\"http://www.spiceevents.fr/contact\" data-type=\"\" target=\"_self\"><strong>Contactez-Nous</strong></a></span></p><p class=\" #(className) font-size-tag-paragraph s-text-font-size-over-default\" style=\"font-size: 15px;\"><span style=\"color: #a67330;\"><a style=\"color: #a67330;\" href=\"tel:+33676403776\" data-type=\"\" target=\"_blank\">+336 76 40 37 76</a></span></p><p class=\" #(className) font-size-tag-paragraph s-text-font-size-over-default\" style=\"font-size: 15px;\"><span style=\"color: #a67330;\"><a style=\"color: #a67330;\" href=\"mailto:contact@spiceevents.fr\" data-type=\"\" target=\"_blank\">contact@spiceevents.fr</a></span></p><p> </p><p class=\" #(className)\"><span style=\"color: var(--s-pre-color10);\"><a style=\"color: var(--s-pre-color10);\" href=\"http://www.spiceevents.fr/amis-partenaires\" data-type=\"\" target=\"_self\"><strong>Nos amis</strong></a></span></p><p class=\" #(className)\"><span style=\"color: #a67330;\"><a style=\"color: #a67330;\" href=\"http://www.jour-j-photographie.com/\" data-type=\"\" target=\"_blank\">Jour-J Photographie</a></span></p><p class=\" #(className)\"><span style=\"color: #a67330;\"><a style=\"color: #a67330;\" href=\"http://www.martialmagie.com/\" data-type=\"\" target=\"_blank\">Martial Magie</a></span></p><p class=\" #(className)\"><span style=\"color: #a67330;\"><a style=\"color: #a67330;\" href=\"https://www.happy-chantilly.com/\" data-type=\"\" target=\"_blank\">Happy Chantilly</a></span></p></div>",
    "backupValue": null,
