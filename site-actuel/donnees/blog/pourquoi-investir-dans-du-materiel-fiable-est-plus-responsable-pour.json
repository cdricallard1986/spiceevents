  "sections": [
   {
    "type": "Blog.Section",
    "id": "d1f9646c-25b7-41ca-9b68-8598fffd7f08",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "037fbe38-60fe-49b9-897a-d319927c5d28",
     "defaultValue": false,
     "value": "<p style=\"font-size: 100%;\">Dans l’événementiel, le choix du matériel est souvent guidé par des critères de performance et de rendu. Pourtant, il s’agit aussi d’un enjeu environnemental. Investir dans un équipement fiable et durable ne répond pas uniquement à une exigence de qualité, mais participe également à une démarche plus responsable. Chez Spice Events, cette approche s’inscrit dans une vision globale : proposer des prestations maîtrisées tout en limitant leur impact sur le long terme.</p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "b96fcdf8-8bab-4cb6-a26d-40fc270717ee",
    "defaultValue": null,
    "component": {
