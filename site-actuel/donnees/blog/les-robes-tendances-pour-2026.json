     "type": "RichText",
     "id": "0515804b-0be9-467b-b720-8c38894b28d8",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\"><strong>La </strong></span><span style=\"color: #000000;\"><em><strong>Old Money Wedding Dress</strong></em></span></p>",
     "backupValue": null,
     "version": 1,
