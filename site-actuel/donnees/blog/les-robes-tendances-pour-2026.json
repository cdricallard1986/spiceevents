    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "7ff97067-52fe-41cf-a58a-123d73f1c791",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\">La robe de mariée courte offre une allure moderne et légère, parfaite pour un mariage estival, civil ou décontracté. Elle allie confort et élégance, mettant en valeur les jambes tout en restant chic et raffinée, idéale pour danser et profiter pleinement de la journée. Polyvalente, elle peut se porter avec des accessoires audacieux pour un look unique. C’est le choix parfait pour celles qui veulent allier liberté de mouvement et style contemporain.</p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
