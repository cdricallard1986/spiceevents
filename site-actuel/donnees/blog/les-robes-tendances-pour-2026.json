    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "e27322c8-7e9e-4249-9da8-8bc615861bcc",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\">La robe de mariée bohème chic allie élégance raffinée et esprit libre. Elle se distingue par des matières fluides, des dentelles délicates et des détails subtils qui apportent sophistication et romantisme. Parfaite pour un mariage en plein air ou dans un cadre intimiste, elle se complète idéalement avec des accessoires discrets, une coiffure naturelle et des bijoux fins, créant un look à la fois moderne et intemporel.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
