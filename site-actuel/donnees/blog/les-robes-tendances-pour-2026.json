   },
   {
    "type": "Blog.Section",
    "id": "db1deac1-4fef-4144-b4aa-03a0426ce3ba",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "2a973614-e349-40ea-8b78-d202c1043033",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\">La robe de mariée </span><span style=\"color: #000000;\"><em>Old Money</em></span><span style=\"color: #000000;\"> incarne une élégance intemporelle, loin des tendances éphémères. Silhouette épurée, matières nobles comme le satin duchesse ou la dentelle, détails raffinés mais jamais ostentatoires : tout est pensé pour un style à la fois sobre, luxueux et maîtrisé. Cette esthétique puise dans l’héritage des grandes maisons et des mariages d’antan, où la sophistication résidait dans la qualité des lignes et la discrétion des ornements. Porter une robe old money, c’est choisir une allure classique, confidentielle et profondément chic, qui transcende les modes.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
