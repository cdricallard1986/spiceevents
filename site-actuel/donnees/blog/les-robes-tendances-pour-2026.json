   {
    "type": "Blog.Section",
    "id": "02aa4f56-dfbd-4627-b1f8-63c36f27a5a8",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "6c484678-94ac-4da0-b9c6-266840467153",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\">La robe de mariée sirène sublime la silhouette grâce à sa coupe ajustée du buste jusqu’aux hanches, puis délicatement évasée au niveau des genoux. Elle met en valeur les courbes avec élégance et crée une allure féminine, raffinée et assumée. C’est la coupe idéale pour celles qui recherchent un style glamour et sophistiqué tout en conservant une belle liberté de mouvement.</p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
