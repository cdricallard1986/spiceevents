   },
   {
    "type": "Blog.Section",
    "id": "40272f8f-39f7-41c5-a62c-7ee74435c045",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "a2412816-20e1-4017-88ab-7f39ad31a904",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\">La robe de mariée 2 en 1 séduit par son côté modulable et ingénieux. Avec sa traîne amovible, elle offre aux mariées le luxe d’une silhouette spectaculaire pour la cérémonie, puis la liberté d’un look plus léger pour la soirée. En un geste, la robe se transforme : majestueuse et solennelle d’abord, moderne et pratique ensuite. Cette option est idéale pour celles qui souhaitent profiter pleinement de leur journée sans renoncer à l’effet “wow”. Une pièce polyvalente, pensée pour allier élégance, confort et mouvement, tout au long du mariage.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
