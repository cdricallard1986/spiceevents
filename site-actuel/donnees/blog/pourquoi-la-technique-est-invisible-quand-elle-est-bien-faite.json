    }
   },
   {
    "type": "Blog.Section",
    "id": "04d3dffa-4ba2-4eea-8a82-9d18b927618c",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "30271d57-3398-4f26-9864-2d8790a66a55",
     "defaultValue": false,
     "value": "<p class=\" p1\"><span style=\"color: #000000;\"><strong>Le bon matériel au bon endroit</strong></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "0e1696d6-fdee-4da9-a8ff-b977e0ed21fa",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "6edf02bb-1e28-4057-965c-17e6d7f71b47",
     "defaultValue": false,
     "value": "<p class=\" p1\"><span style=\"color: #000000;\">La </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/performances-techniques-son-and-lumieres\" data-type=\"undefined\" target=\"_self\"><u>performance technique</u></a></span><span style=\"color: #000000;\"> ne dépend pas uniquement de la puissance du matériel, mais de son adéquation avec le lieu et le moment. Inutile d’en faire trop : mieux vaut un dispositif parfaitement dimensionné, réglé avec précision, qu’une démonstration technique inutile.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "7f2feb2f-e870-47fc-9c48-b6d5468dd9b1",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "420d5854-5da9-4465-9b9f-2e83adf0aa83",
     "defaultValue": false,
     "value": "<p class=\" p1\"><span style=\"color: #000000;\">Chez Spice Events, nous sélectionnons chaque équipement pour sa fiabilité, sa discrétion et sa capacité à servir l’émotion, qu’il s’agisse d’une </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/mariages\" data-type=\"undefined\" target=\"_self\"><u>cérémonie laïque</u></a></span><span style=\"color: #000000;\">, d’un cocktail, d’une soirée dansante ou d’un </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/evenementiel\" data-type=\"undefined\" target=\"_self\"><u>événement professionnel</u></a></span><span style=\"color: #000000;\">.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
