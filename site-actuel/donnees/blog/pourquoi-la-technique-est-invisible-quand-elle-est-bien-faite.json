    }
   },
   {
    "type": "Blog.Section",
    "id": "33549207-24ef-4648-8fe3-6488aa062e3e",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "20ba595a-fcf0-48e2-9270-cdb57dd7a1c8",
     "defaultValue": false,
     "value": "<p class=\" p1\"><span style=\"color: #000000;\">Une </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/ouverture-de-bal-spectaculaire\" data-type=\"undefined\" target=\"_self\"><u>ouverture de bal spectaculaire</u></a></span><span style=\"color: #000000;\">, une prise de parole parfaitement audible, une lumière qui accompagne un moment clé… La </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/performances-techniques-son-and-lumieres\" data-type=\"undefined\" target=\"_self\"><u>technique</u></a></span><span style=\"color: #000000;\"> n’est jamais une fin en soi. Elle est là pour amplifier les émotions, renforcer l’impact d’un instant et créer des souvenirs durables.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "dfa64fa8-6e13-4121-a04a-5769cd7cdffd",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "d299d72b-04ee-4bd7-9642-6ad65a6b451e",
     "defaultValue": false,
     "value": "<p class=\" p1\"><span style=\"color: #000000;\">Lorsqu’elle est bien réalisée, les invités ne se demandent pas comment cela fonctionne. Ils profitent simplement du moment.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
