    "component": {
     "type": "RichText",
     "id": "dedf7c02-c27c-4cf7-947f-30fca32b2856",
     "defaultValue": false,
     "value": "<p class=\" s1 li1\"><span style=\"color: #000000;\">- l’envoi des plats,</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "e66f4eee-a657-4aa4-af89-09f3f7a214fa",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "4e2d2bd4-54a2-4abf-883a-7267983109ec",
     "defaultValue": false,
     "value": "<p class=\" s1 li1\"><span style=\"color: #000000;\">- la fluidité du service,</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "d51d9bfe-cfee-4b5d-87ea-4f5201104dcd",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "9b1e662e-3af6-4ebe-8229-c88424151dae",
     "defaultValue": false,
     "value": "<p class=\" p2\"><span style=\"color: #000000;\">- le confort des invités.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "b6e2b251-8857-4fdc-bb0c-6ea28e75d720",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "0c061fec-a53c-48d5-8041-27930d21bd7a",
     "defaultValue": false,
     "value": "<p class=\" p1\"><span style=\"color: #000000;\">Cette coordination permet d’assurer une ambiance cohérente, élégante et respectueuse du déroulé du repas.</span></p>",
     "backupValue": null,
     "version": 1,
