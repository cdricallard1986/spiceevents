     "type": "RichText",
     "id": "d65fde1a-297e-4b1a-b3a3-6d3fcad86263",
     "defaultValue": false,
     "value": "<p><span style=\"color: #000000;\">Pour les </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/mariages\" data-type=\"undefined\" target=\"_self\"><u>mariés</u></a></span><span style=\"color: #000000;\"> ou les </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/evenementiel\" data-type=\"undefined\" target=\"_self\"><u>organisateurs d’événements</u></a></span><span style=\"color: #000000;\">, cette coordination en amont est souvent invisible… et c’est justement le signe qu’elle est réussie. Ils peuvent profiter pleinement de leur événement, en toute confiance, sans avoir à gérer les détails techniques ou le timing.</span></p>",
     "backupValue": null,
     "version": 1,
