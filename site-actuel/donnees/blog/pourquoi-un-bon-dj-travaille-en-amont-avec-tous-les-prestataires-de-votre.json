    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "9bddcb98-9967-4623-a8d5-17cbc0fd089a",
     "defaultValue": false,
     "value": "<p class=\" p2\"><span style=\"color: #000000;\"><strong>Travailler avec le traiteur pour un timing parfait</strong></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "7efe77da-73ac-4701-a521-25d7aedf2e7c",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "6a54a6c8-aba0-45e8-96d6-7131a459e82f",
     "defaultValue": false,
     "value": "<p class=\" p1\"><span style=\"color: #000000;\">Un bon DJ prend également contact avec le traiteur. Pourquoi ? Parce que le rythme musical doit s’adapter au service. Discours, animations ou moments forts ne doivent jamais perturber :</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "17975b8d-8e6a-4575-8276-679182907cab",
