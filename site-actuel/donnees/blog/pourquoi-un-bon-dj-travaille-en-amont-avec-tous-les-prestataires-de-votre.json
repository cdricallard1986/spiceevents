     "defaultValue": false,
     "value": "<p class=\" s1 li1\"><span style=\"color: #000000;\"><strong>Une entente clé avec les photographes et vidéastes</strong></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "75c0c27f-fcfc-4be4-8d8d-48803a31747a",
