    "component": {
     "type": "RichText",
     "id": "ba34644f-f4bb-4a95-b538-b44a1f571658",
     "defaultValue": false,
     "value": "<p class=\" s1 li1\"><span style=\"color: #000000;\">Certains instants ne se reproduisent qu’une seule fois. Un DJ professionnel échange avec les photographes et vidéastes pour :</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
