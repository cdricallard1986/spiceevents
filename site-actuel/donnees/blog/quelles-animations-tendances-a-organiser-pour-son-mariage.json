    "component": {
     "type": "RichText",
     "id": "65ef4e79-65bd-482f-8678-ceeb56849798",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify; font-size: 100%;\"><span style=\"color: #000000;\">Organiser un mariage ou un événement réussi repose sur une combinaison de plusieurs éléments : une ambiance soignée, une expérience immersive et des animations qui marquent les esprits. Chez Spice Events, nous proposons des animations modernes, élégantes et interactives, pensées pour créer du lien entre vos invités et sublimer chaque moment de votre journée. Découvrez les animations les plus tendance pour mariage, soirée d’entreprise, anniversaire, ou tout autre événement.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
