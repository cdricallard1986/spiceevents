   {
    "type": "Blog.Section",
    "id": "e2de3888-73c3-4e9d-96d9-9a6fc1dd208b",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "5d38f059-cda7-4ee2-b116-4c4aba2d7253",
     "defaultValue": false,
     "value": "<h2 style=\"text-align: justify; font-size: 100%;\"><span style=\"color: #000000;\">Le livre d’or audio est une animation moderne qui séduit par son authenticité. À travers un combiné téléphonique rétro, vos invités laissent des messages vocaux spontanés, drôles, touchants ou émouvants.</span><br><span style=\"color: #000000;\">Cette animation crée des souvenirs audio uniques, parfaits pour revivre l’émotion du mariage ou de l’événement. Elle remplace avantageusement le livre d’or traditionnel et reste un choix très recherché pour les couples en quête d’une animation intime, innovante et pleine d’émotions.</span></h2>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
