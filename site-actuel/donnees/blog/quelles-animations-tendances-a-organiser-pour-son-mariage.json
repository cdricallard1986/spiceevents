     "type": "RichText",
     "id": "cad1c1ae-4d55-4260-8bd5-7250af8d5a54",
     "defaultValue": false,
     "value": "<h2 style=\"text-align: justify; font-size: 100%;\"><span style=\"color: #000000;\">Le Photobooth est une animation indémodable. Il permet à vos invités de repartir avec des photos instantanées et personnalisées, tout en créant des moments fun et spontanés. Personnalisable selon votre thème (cadres, arrière-plans, templates…), il s’intègre parfaitement à tous types d’événements : mariage, soirée privée, séminaire, inauguration, etc. C’est une valeur sûre pour dynamiser votre réception et créer une atmosphère chaleureuse.</span></h2>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
