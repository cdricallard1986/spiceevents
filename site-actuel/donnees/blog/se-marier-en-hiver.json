     "id": "c42dc3f6-4175-4425-814a-acd3e09ded94",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\"> Vous connaissez à présent tous les avantages d'un mariage hivernal ! </span></p>",
