   {
    "type": "Blog.Section",
    "id": "363da48c-bc24-48b5-991b-4648246d3a9d",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "95e86390-508f-43d6-a416-f7c806e0c19c",
     "defaultValue": false,
     "value": "<p style=\"text-align: center; font-size: 20px;\"><span style=\"color: #000000;\"><strong>Vidéo souvenir</strong></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "3766fee8-2c3b-4160-9b00-e44a5850d5bf",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "ce4e590f-56bf-41af-a91c-280e42c4e33a",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\">Plus original et moderne que les photos : les vidéos souvenirs. Elles sont de plus en plus utilisées pour garder le souvenir d’un événement. Un vidéaste peut assister à votre mariage et ensuite réaliser un film, vos proches peuvent monter une jolie vidéo de messages personnalisés, avant ou pendant le mariage... </span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "f6b9fa12-bff2-4c7d-8968-a07567c314a2",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "825591f6-2d37-4450-b0ea-1180aeb620ce",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\">Il existe aujourd’hui mille et une façons de se créer des souvenirs vidéo, et de pouvoir les regarder à n’importe quel moment de votre vie. </span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "1f1a125b-41d4-4e3c-908b-391107779dcd",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "426dd8c5-8e5d-4379-9419-a70a6e0f18ef",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\">Si vous ne savez pas vers qui vous tournez en ce qui concerne le matériel vidéo, Spice Events se fera un plaisir de vous </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/accompagnement\" data-type=\"\" target=\"_self\"><u>conseiller</u></a></span><span style=\"color: #000000;\">. </span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
