   {
    "type": "Blog.Section",
    "id": "6d08951b-2cea-49c7-8d41-d2640ee4fbb5",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "82b8e8d4-1266-44b2-a0bf-129681bdc8fc",
     "defaultValue": false,
     "value": "<p class=\" p3\"><span style=\"color: #000000;\">Les </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/guirlandes-lumineuses\" data-type=\"undefined\" target=\"_self\"><u>guirlandes lumineuse</u></a></span><span style=\"color: #000000;\">s permettent également de structurer visuellement un lieu. Elles peuvent délimiter des zones, guider les invités ou mettre en valeur certains espaces clés de votre </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/evenementiel\" data-type=\"undefined\" target=\"_self\"><u>événement</u></a></span><span style=\"color: #000000;\">. Installées en ciel étoilé au-dessus d’un dîner, tendues entre des arbres, fixées sur des structures ou intégrées à une tente, elles habillent les volumes et donnent une véritable identité à votre scénographie.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
