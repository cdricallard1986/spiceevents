   {
    "type": "Blog.Section",
    "id": "c189c9f7-2e49-4359-80b8-0585c0ccab4e",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "338d8fff-2731-4290-916e-f82cd27c66d6",
     "defaultValue": false,
     "value": "<p class=\" p2\"><span style=\"color: #000000;\">Dans l’univers du </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/mariages\" data-type=\"undefined\" target=\"_self\"><u>mariage</u></a></span><span style=\"color: #000000;\">, les </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/guirlandes-lumineuses\" data-type=\"undefined\" target=\"_self\"><u>guirlandes guinguettes</u></a></span><span style=\"color: #000000;\"> sont devenues un incontournable. Elles accompagnent parfaitement les moments forts : cocktail en extérieur, dîner sous les étoiles, ouverture de bal ou soirée dansante. Elles créent une atmosphère romantique et chaleureuse sans jamais voler la vedette aux mariés. Associées à d’autres éléments comme la sonorisation, l’éclairage décoratif ou les animations proposées par </span><span style=\"color: #000000;\"><strong>Spice Events</strong></span><span style=\"color: #000000;\">, elles participent à une mise en scène harmonieuse et élégante.</span><span style=\"color: #000000;\"><br></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
