  "sections": [
   {
    "type": "Blog.Section",
    "id": "d68864da-dc58-497b-8796-117886a53fbf",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "5d365931-ec1d-442f-ae0d-f42a45c1796e",
     "defaultValue": false,
     "value": "<p><span style=\"color: #000000;\">Les </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/guirlandes-lumineuses\" data-type=\"undefined\" target=\"_self\"><u>guirlandes lumineuses</u></a></span><span style=\"color: #000000;\">, aussi appelées guirlandes guinguettes, se sont imposées comme un élément phare de la scénographie événementielle. Intemporelles et élégantes, elles offrent une lumière chaleureuse qui transforme instantanément un lieu et crée une atmosphère conviviale, festive et raffinée. Chez </span><span style=\"color: #000000;\"><strong>Spice Events</strong></span><span style=\"color: #000000;\">, nous les considérons comme bien plus qu’un simple éclairage : ce sont de véritables outils de mise en scène au service de l’émotion.</span><span style=\"color: #000000;\"><br></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "143d9087-5e94-404f-b41a-030f33e3132b",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "1c9534a0-a442-4d0d-8501-e3b894f1453c",
     "defaultValue": false,
     "value": "<p class=\" p3\"><span style=\"color: #000000;\"><strong>Une lumière douce pour une ambiance unique</strong></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "969aed55-5971-4d72-abef-205131700ccf",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "9022427a-bda8-4934-878e-0bf4f65a892e",
     "defaultValue": false,
     "value": "<p class=\" p3\"><span style=\"color: #000000;\">Contrairement à un éclairage classique, les </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/guirlandes-lumineuses\" data-type=\"undefined\" target=\"_self\"><u>guirlandes guinguettes</u></a></span><span style=\"color: #000000;\"> diffusent une lumière chaude et enveloppante. Elles invitent au partage, à la convivialité et à la détente. Que ce soit pour un </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/mariages\" data-type=\"undefined\" target=\"_self\"><u>mariage</u></a></span><span style=\"color: #000000;\">, une </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/evenementiel\" data-type=\"undefined\" target=\"_self\"><u>soirée privée ou un événement professionnel</u></a></span><span style=\"color: #000000;\">, elles apportent ce supplément d’âme qui rend un moment inoubliable. Leur esthétique simple et élégante s’adapte à tous les styles : champêtre, bohème, chic, moderne ou industriel.</span><span style=\"color: #000000;\"><br></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
