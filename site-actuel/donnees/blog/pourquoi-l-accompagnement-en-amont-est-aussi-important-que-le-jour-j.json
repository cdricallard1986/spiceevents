   {
    "type": "Blog.Section",
    "id": "2396eb93-81c5-4705-bd7f-e560abef5c90",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "7f097314-e2c2-40f7-88db-1928efaeccf7",
     "defaultValue": false,
     "value": "<p class=\" p4\" style=\"text-align: justify;\"><span style=\"color: #000000;\">Contrairement à une approche standardisée, le travail préparatoire permet d’adapter finement chaque prestation. Chez </span><span style=\"color: #000000;\"><strong>Spice Events</strong></span><span style=\"color: #000000;\">, </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/booking-dj\" data-type=\"undefined\" target=\"_self\"><u>le mix musical, les transitions,</u></a></span><span style=\"color: #000000;\"> </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/performances-techniques-son-and-lumieres\" data-type=\"undefined\" target=\"_self\"><u>l’éclairage</u></a></span><span style=\"color: #000000;\"> et les </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/animations-tendances\" data-type=\"undefined\" target=\"_self\"><u>animations</u></a></span><span style=\"color: #000000;\"> sont pensés en fonction du lieu, du public et du style souhaité. Cette personnalisation en profondeur est ce qui transforme une simple animation en véritable expérience. Elle repose sur une écoute active et sur des ajustements progressifs tout au long de la préparation.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
