    "component": {
     "type": "RichText",
     "id": "962fbf65-1679-498a-8601-c1fd81f1571e",
     "defaultValue": false,
     "value": "<p class=\" p4\" style=\"text-align: justify;\"><span style=\"color: #000000;\">Un </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/mariages\" data-type=\"undefined\" target=\"_self\"><u>mariage</u></a></span><span style=\"color: #000000;\"> est une mécanique précise où chaque moment s’enchaîne. L’</span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/accompagnement\" data-type=\"undefined\" target=\"_self\"><u>accompagnement en amont</u></a></span><span style=\"color: #000000;\"> permet de construire une véritable feuille de route de l’événement, en identifiant les temps forts et les points de vigilance. Cette planification détaillée, associée à une coordination avec l’ensemble des prestataires, garantit un déroulé fluide et ponctuel. L’objectif est clair : permettre aux mariés de vivre chaque instant avec sérénité, sans avoir à gérer la technique ou le timing pendant leur journée.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
