  "sections": [
   {
    "type": "Blog.Section",
    "id": "a80df4b3-0f8f-44a9-b1c6-74c3241a57bd",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "655ccfa6-031c-4551-8610-8759a555bdd5",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\">Lorsqu’on pense à un </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/mariages\" data-type=\"undefined\" target=\"_self\"><u>mariage</u></a></span><span style=\"color: #000000;\"> réussi, l’attention se porte naturellement sur la soirée, la piste de danse ou l’ambiance le jour J. Pourtant, l’expérience montre que la qualité d’un événement dépend en grande partie du </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/accompagnement\" data-type=\"undefined\" target=\"_self\"><u>travail réalisé en amont</u></a></span><span style=\"color: #000000;\">. Chez </span><span style=\"color: #000000;\"><strong>Spice Events</strong></span><span style=\"color: #000000;\">, chaque prestation repose sur une préparation structurée qui permet d’anticiper les attentes, d’éviter les imprévus et de garantir une exécution fluide le moment venu. Comme le souligne notre approche, un premier échange permet de découvrir précisément les envies des mariés afin de concevoir un événement réellement à leur image.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
