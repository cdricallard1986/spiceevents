   {
    "type": "Blog.Section",
    "id": "ffe3e28c-f8ab-4368-95ef-e7514b450667",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "74f6c45b-710f-4e52-92c8-50b243c3b728",
     "defaultValue": false,
     "value": "<p class=\" p4\" style=\"text-align: justify;\"><span style=\"color: #000000;\">L’exécution le jour J est évidemment essentielle, mais elle n’est que la partie visible d’un travail beaucoup plus large. C’est l’</span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/accompagnement\" data-type=\"undefined\" target=\"_self\"><u>accompagnement en amont</u></a></span><span style=\"color: #000000;\"> qui sécurise l’événement, affine la personnalisation et permet d’atteindre un véritable niveau d’excellence. Chez </span><span style=\"color: #000000;\"><strong>Spice Events</strong></span><span style=\"color: #000000;\">, nous considérons cette phase préparatoire comme la clé d’une soirée réussie, parce que les plus beaux moments sont toujours ceux qui ont été parfaitement anticipés.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
