    "component": {
     "type": "RichText",
     "id": "67116902-29ad-43fa-a644-a32dd993727e",
     "defaultValue": false,
     "value": "<p class=\" p4\" style=\"text-align: justify;\"><span style=\"color: #000000;\">L’un des bénéfices majeurs de l’</span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/accompagnement\" data-type=\"undefined\" target=\"_self\"><u>accompagnement en amont</u></a></span><span style=\"color: #000000;\"> est la tranquillité d’esprit qu’il apporte aux futurs mariés. En étant guidés étape par étape, ils peuvent se concentrer sur les autres aspects de leur organisation. Les retours clients montrent d’ailleurs que des échanges réactifs et structurés avant l’événement permettent aux couples d’aborder leur </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/mariages\" data-type=\"undefined\" target=\"_self\"><u>mariage</u></a></span><span style=\"color: #000000;\"> avec beaucoup plus de sérénité. Cette dimension humaine fait pleinement partie de l’ADN de </span><span style=\"color: #000000;\"><strong>Spice Events</strong></span><span style=\"color: #000000;\">, où l’écoute et la proximité sont considérées comme essentielles à la réussite d’un événement.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
