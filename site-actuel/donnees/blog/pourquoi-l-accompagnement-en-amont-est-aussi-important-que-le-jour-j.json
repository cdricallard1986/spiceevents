   {
    "type": "Blog.Section",
    "id": "e3c2408d-2d5e-4a1d-9ea0-ed41dccefcf9",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "fe250efb-430c-4708-b389-b51089e489a5",
     "defaultValue": false,
     "value": "<p class=\" p4\" style=\"text-align: justify;\"><span style=\"color: #000000;\">La philosophie de </span><span style=\"color: #000000;\"><strong>Spice Events</strong></span><span style=\"color: #000000;\"> repose sur une conviction simple : une grande soirée ne s’improvise pas. C’est pourquoi nous privilégions un </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/accompagnement\" data-type=\"undefined\" target=\"_self\"><u>accompagnement complet</u></a></span><span style=\"color: #000000;\">, depuis les premiers échanges jusqu’à la dernière danse. Cette méthode permet de créer une expérience cohérente, fluide et fidèle aux attentes des mariés. Elle garantit également une meilleure </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/performances-techniques-son-and-lumieres\" data-type=\"undefined\" target=\"_self\"><u>coordination technique</u></a></span><span style=\"color: #000000;\"> et artistique, au service d’un seul objectif : faire vivre aux couples et à leurs invités un moment réellement mémorable.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
