     "id": "461263da-6dc0-4c69-8508-b2b91988b127",
     "defaultValue": false,
     "value": "<p class=\" p4\" style=\"text-align: justify;\"><span style=\"color: #000000;\"><strong>L’approche Spice Events : </strong></span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/accompagnement\" data-type=\"undefined\" target=\"_self\"><u><strong>accompagner de A à Z</strong></u></a></span></p>",
