    "component": {
     "type": "RichText",
     "id": "6c0e97a9-ec1e-4101-aafc-cd5ea2ac0846",
     "defaultValue": false,
     "value": "<p class=\" p4\" style=\"text-align: justify;\"><span style=\"color: #000000;\">L’</span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/accompagnement\" data-type=\"undefined\" target=\"_self\"><u>accompagnement en amont</u></a></span><span style=\"color: #000000;\"> permet avant tout de comprendre la vision des mariés dans sa globalité. À travers des échanges personnalisés et un questionnaire détaillé, il devient possible de cerner les goûts musicaux, les moments clés et </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/booking-dj\" data-type=\"undefined\" target=\"_self\"><u>l’ambiance recherchée</u></a></span><span style=\"color: #000000;\">. Cette phase est essentielle car elle conditionne toutes les décisions suivantes : </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/booking-dj\" data-type=\"undefined\" target=\"_self\"><u>choix musicaux, rythme de la soirée,</u></a></span><span style=\"color: #000000;\"> </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/performances-techniques-son-and-lumieres\" data-type=\"undefined\" target=\"_self\"><u>mise en lumière</u></a></span><span style=\"color: #000000;\"> ou encore coordination avec les autres prestataires. Sans ce travail préparatoire, l’exécution le jour J risque d’être plus standardisée et moins alignée avec les attentes réelles du couple.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
