     "defaultValue": false,
     "value": "<p style=\"text-align: justify; font-size: 100%;\"><span style=\"color: #000000;\">Si vous avez besoin de plus d’informations ou de </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/accompagnement\" data-type=\"undefined\" target=\"_self\"><u>conseils</u></a></span><span style=\"color: #000000;\">, n'hésitez pas à </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/contactez-nous\" data-type=\"\" target=\"_self\"><u>nous contacter</u></a></span><span style=\"color: #000000;\">, nous nous ferons un plaisir de vous aider !</span></p>",
