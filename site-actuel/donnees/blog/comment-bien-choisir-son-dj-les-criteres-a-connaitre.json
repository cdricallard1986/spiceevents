     "defaultValue": false,
     "value": "<p class=\" p3\" style=\"text-align: justify;\"><span style=\"color: #000000;\"><strong>Le </strong></span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/booking-dj\" data-type=\"undefined\" target=\"_self\"><u><strong>DJ</strong></u></a></span><span style=\"color: #000000;\"><strong>, garant du timing et de l’équilibre</strong></span></p>",
     "backupValue": null,
