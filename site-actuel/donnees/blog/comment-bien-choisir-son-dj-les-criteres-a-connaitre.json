   {
    "type": "Blog.Section",
    "id": "5d6eb8e3-51fb-4dc7-a7f3-2aa8d063abd6",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "992c1339-9a12-49f3-8b93-89a4b28897ed",
     "defaultValue": false,
     "value": "<p class=\" p2\" style=\"text-align: justify;\"><span style=\"color: #000000;\">Un </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/booking-dj\" data-type=\"undefined\" target=\"_self\"><u>DJ professionnel</u></a></span><span style=\"color: #000000;\"> travaille bien avant le jour J. Il vous </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/accompagnement\" data-type=\"undefined\" target=\"_self\"><u>accompagne</u></a></span><span style=\"color: #000000;\"> dans la construction du déroulé, vous aide à anticiper les moments importants et vous conseille sur les choix techniques et artistiques. Chez Spice Events, </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/accompagnement\" data-type=\"undefined\" target=\"_self\"><u>cet accompagnement fait partie intégrante de la prestation </u></a></span><span style=\"color: #000000;\">: conseils sur le rythme de la journée, enchaînement des temps forts, gestion des transitions, cohérence entre cérémonie, cocktail et soirée. Tout est pensé pour que l’événement se déroule naturellement, sans ruptures ni temps morts.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
