   {
    "type": "Blog.Section",
    "id": "fe64d54f-54cc-4c27-a619-d961e3636e57",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "9de967db-bb41-4d1f-abcf-29a14747c75f",
     "defaultValue": false,
     "value": "<p class=\" p2\" style=\"text-align: justify;\"><span style=\"color: #000000;\">Au-delà de la musique, le </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/booking-dj\" data-type=\"undefined\" target=\"_self\"><u>DJ</u></a></span><span style=\"color: #000000;\"> joue un rôle central dans le timing. Il sait quand lancer un moment fort, quand ralentir, quand relancer l’énergie ou au contraire laisser place à l’émotion. Un bon </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/booking-dj\" data-type=\"undefined\" target=\"_self\"><u>DJ</u></a></span><span style=\"color: #000000;\"> ne cherche pas à être omniprésent : il s’adapte, observe et ajuste en permanence pour respecter le rythme de vos invités et l’esprit de votre événement.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
