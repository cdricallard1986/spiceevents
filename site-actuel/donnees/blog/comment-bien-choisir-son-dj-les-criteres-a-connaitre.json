     "type": "RichText",
     "id": "fe1651fb-6b09-4061-9570-a528727506ba",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\">Choisir son </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/booking-dj\" data-type=\"undefined\" target=\"_self\"><u>DJ</u></a></span><span style=\"color: #000000;\">, ce n’est pas simplement sélectionner quelqu’un qui passera de la musique le jour J. Chez Spice Events, nous sommes convaincus que le </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/booking-dj\" data-type=\"undefined\" target=\"_self\"><u>DJ</u></a></span><span style=\"color: #000000;\"> est l’un des piliers de votre événement, à la fois chef d’orchestre de l’ambiance, repère pour le timing et garant du confort sonore de vos invités.</span></p>",
     "backupValue": null,
     "version": 1,
