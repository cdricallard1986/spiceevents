   {
    "type": "Blog.Section",
    "id": "5e3cd9ab-67e7-4280-a0f9-70afb6083772",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "b76ec700-9cfe-481e-b196-6e6b7045924d",
     "defaultValue": false,
     "value": "<p class=\" p3\" style=\"text-align: justify;\"><span style=\"color: #000000;\">Un bon </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/booking-dj\" data-type=\"undefined\" target=\"_self\"><u>DJ</u></a></span><span style=\"color: #000000;\"> commence par écouter. Vos envies, votre histoire, le type d’événement, le public attendu, le lieu… tout compte. Chez Spice Events, chaque projet démarre par un échange approfondi afin de comprendre l’atmosphère recherchée et les temps forts à mettre en valeur. Le rôle du </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/booking-dj\" data-type=\"undefined\" target=\"_self\"><u>DJ</u></a></span><span style=\"color: #000000;\"> est de traduire votre univers en ambiance musicale, pas d’imposer un style ou une sélection toute faite.</span><br></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
