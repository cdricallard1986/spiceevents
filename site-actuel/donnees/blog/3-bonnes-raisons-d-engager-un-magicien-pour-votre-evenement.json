    "component": {
     "type": "RichText",
     "id": "ceb31204-a170-44e4-88a5-b3bf4e625d3c",
     "defaultValue": false,
     "value": "<p style=\"text-align: center; font-size: 20px;\"><span style=\"color: #000000;\"><strong>Un moment unique</strong></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "8cbac2c2-9fe0-41c1-9ef3-3e99adf26366",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "69fd8e74-b325-44cd-a670-c6d2395a65dd",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\">Le magicien peut proposer des spectacles de magie rapprochée ou close up.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "2e9b304c-25c2-4f2e-8b00-5bc1105b54e6",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "bcb10441-1116-4ec6-90d8-50d67b2928bc",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\">Ce type de magie permet aux spectateurs de prendre part aux tours de magie. Le magicien passe de table en table, prend un moment avec chaque personne pour l'emmener dans son monde.  </span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "bd5652db-028a-41ad-94bf-243a45c9e042",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "6b3f02b8-e203-4228-aff9-1d71256e4fb3",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\">Vous pouvez également faire appel à un mentaliste, qui pourra prédire le comportement d'un de vos invités ainsi que des détails sur sa vie personnelle.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "5e1d735f-3bf4-463e-af93-5310fc2c6ae5",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "867ab6cf-8d45-4167-9829-f57a60fa6017",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\">Un spectacle en intimité, juste pour vous et vos invités, qui restera en mémoire et se glissera sans doute dans les conversations des jours suivants.  </span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
