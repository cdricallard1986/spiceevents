     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\">Vous hésitez à engager un magicien pour votre événement privé? Voici 3 bonnes raisons de se décider !</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "929933b4-dd3d-4d15-b02a-e4596c33df67",
    "defaultValue": null,
    "component": {
