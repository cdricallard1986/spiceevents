     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/on-vous-rappelle\" data-type=\"\" target=\"_self\"><strong>L’équipe Spice Events espère vous avoir aidé dans vos recherches, pour toutes autres questions, n’hésitez pas à nous </strong></a></span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/contactez-nous\" data-type=\"\" target=\"_self\"><u><strong>contacter</strong></u></a></span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/on-vous-rappelle\" data-type=\"\" target=\"_self\"><strong>, nous nous ferons un plaisir de vous répondre</strong></a></span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/on-vous-rappelle\" data-type=\"\" target=\"_self\"><strong>.</strong></a></span></p>",
