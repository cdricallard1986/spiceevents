    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "320a7540-1400-4be9-933e-f267fa0861ef",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\">Non ce n’est pas le bruit de votre cœur mais bien celui d’un magnifique feu d’artifice pour terminer en beauté cette journée déjà inoubliable. </span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "c039bd38-91a6-4dff-9fdb-35bbb74f070e",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "b77af9d8-b4c5-4025-aeca-b32e83868796",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\">Admiré par les petits comme par les grands, il mettra des étoiles plein les yeux à vos convives. En fonction de votre budget, votre emplacement et de son envergure, vous pouvez faire appel à un artificier professionnel ou décider de le tirer vous-même. </span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "3db6b142-1ab4-4e04-8a96-cfbf24e98562",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "313fe7bd-975e-4334-af2b-ef44fcd60cd7",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\">Mais qu’importe la manière, choisissez un feu d’artifice qui vous ressemble et vous représente, vous et votre conjoint(e). C’est votre jour !</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
