     "defaultValue": false,
     "value": "<p style=\"text-align: center; font-size: 20px;\"><span style=\"color: #000000;\"><strong>Un lieu avec cheminée</strong></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "35f81909-f962-4b3c-8123-4e589101a119",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "cdd3f885-471f-48f5-9d04-05579b05ccd6",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\">Qui dit hiver, dit cheminée. Et cet élément hivernal pourrait être l’objet de décoration phare de votre lieu de réception. Avec elle, le chaleureux et la convivialité seront au rendez-vous. </span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
