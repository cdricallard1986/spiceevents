     "id": "d7506dad-8da9-4816-92af-b95e76a5e9c4",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\">Vous souhaitez vous marier en hiver mais vous ne savez pas où organiser votre réception ? Spice a trouvé pour vous 3 idées de lieux pour un mariage hivernal réussi. </span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "bd7afcff-81fc-4b90-b393-95bc7d65c6e7",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "1943a962-1adb-4891-983d-8074f740ff8e",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"display: inline-block\"></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
