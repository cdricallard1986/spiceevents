    "component": {
     "type": "RichText",
     "id": "1c94bd92-35da-4577-a726-2093117ea27d",
     "defaultValue": false,
     "value": "<p class=\" p3\" style=\"text-align: justify;\"><span style=\"color: #000000;\">L’un des avantages majeurs de l’</span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/performances-techniques-son-and-lumieres\" data-type=\"undefined\" target=\"_self\"><u>éclairage</u></a></span><span style=\"color: #000000;\"> est sa capacité à transformer un espace sans modification structurelle. Un lieu simple peut devenir élégant, chaleureux ou spectaculaire grâce à une mise en lumière adaptée. Cette transformation est souvent ce qui marque les invités et donne cette impression de standing supérieur.</span></p>",
     "backupValue": null,
