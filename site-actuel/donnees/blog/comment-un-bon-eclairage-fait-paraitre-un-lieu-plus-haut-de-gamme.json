    "component": {
     "type": "RichText",
     "id": "7a094673-0c0d-4f73-a546-c37b540d6667",
     "defaultValue": false,
     "value": "<p class=\" p3\" style=\"text-align: justify;\"><span style=\"color: #000000;\">Un </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/performances-techniques-son-and-lumieres\" data-type=\"undefined\" target=\"_self\"><u>bon éclairage</u></a></span><span style=\"color: #000000;\"> ne se limite pas à éclairer un lieu, il en révèle tout le potentiel. Il structure l’espace, renforce l’ambiance et élève immédiatement la perception globale de l’événement. Dans un </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/mariages\" data-type=\"undefined\" target=\"_self\"><u>mariage</u></a></span><span style=\"color: #000000;\"> comme dans tout </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/evenementiel\" data-type=\"undefined\" target=\"_self\"><u>événement</u></a></span><span style=\"color: #000000;\">, c’est souvent ce niveau de détail qui fait la différence entre une belle soirée et une expérience réellement haut de gamme.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
