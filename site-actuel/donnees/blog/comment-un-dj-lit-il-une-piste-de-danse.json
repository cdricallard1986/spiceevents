   {
    "type": "Blog.Section",
    "id": "2c6cad2e-42f7-41cd-9cbb-7eba7d7b3b74",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "060a966d-ecaa-4398-ae2e-742c35c9eaed",
     "defaultValue": false,
     "value": "<p class=\" p1\" style=\"text-align: justify;\"><span style=\"color: #000000;\"><strong>Une compétence humaine avant tout</strong></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "c34fbdfa-fe36-43a5-aad3-fec6355319e4",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "4ff62522-1b13-41d6-a05d-9e71ce945128",
     "defaultValue": false,
     "value": "<p class=\" p1\" style=\"text-align: justify;\"><span style=\"color: #000000;\">Lire une piste de danse est avant tout une question de sensibilité humaine. Cela demande de l’expérience, de l’écoute et une vraie capacité à se connecter aux invités. Chaque soirée est différente, chaque public a sa propre énergie, et aucune recette ne fonctionne à l’identique deux fois.</span><span style=\"color: #000000;\"><br></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "2975ec31-abb2-46db-9961-bedf5b942093",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "be438c6e-eb83-494c-a846-be798b30d45d",
     "defaultValue": false,
     "value": "<p class=\" p1\" style=\"text-align: justify;\"><span style=\"color: #000000;\">Chez </span><span style=\"color: #000000;\"><strong>Spice </strong></span><span style=\"color: #000000;\"><strong>Events</strong></span><span style=\"color: #000000;\">, cett</span><span style=\"color: #000000;\">e lecture fine de la piste de danse fait partie intégrante de chaque </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/booking-dj\" data-type=\"undefined\" target=\"_self\"><u>prestation DJ</u></a></span><span style=\"color: #000000;\">. C’est ce qui nous permet de créer des ambiances fluides, cohérentes et mémorables, où chaque invité trouve sa place et vit pleinement l’instant.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "0dfb5692-a793-4e82-9b49-d9aec5bc2e97",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "5ccb07b2-fdd2-4f57-bdcd-b3e44243646c",
     "defaultValue": false,
     "value": "<p class=\" p1\" style=\"text-align: justify;\"><span style=\"color: #000000;\">Parce qu’une piste de danse ne se contrôle pas. Elle se comprend, se respecte et se guide.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "3f3a31fa-6270-4b69-9874-b52ae2c0432e",
    "defaultValue": null,
