     "id": "fba166a8-47d9-4f31-917d-c7872db61faf",
     "defaultValue": false,
     "value": "<p class=\" p1\" style=\"text-align: justify;\"><span style=\"color: #000000;\"><strong>Une alternative moderne et émotionnelle</strong></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "5805ab38-53e5-4771-a4f6-9236a4468d25",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "4f47bcfc-9c5a-4178-9728-0ea7d73fc9f2",
     "defaultValue": false,
     "value": "<p class=\" p1\" style=\"text-align: justify;\"><span style=\"color: #000000;\">Le </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/livre-d-or-audio\" data-type=\"undefined\" target=\"_self\"><u>livre d’or audio</u></a></span><span style=\"color: #000000;\"> de Spice Events est l’alternative parfaite au livre classique. Il combine émotion, originalité et interactivité, et permet de conserver des instants précieux sous une forme vivante. Que ce soit pour un </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/mariages\" data-type=\"undefined\" target=\"_self\"><u>mariage</u></a></span><span style=\"color: #000000;\"> ou un </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/evenementiel\" data-type=\"undefined\" target=\"_self\"><u>événement professionnel</u></a></span><span style=\"color: #000000;\"> marquant, il crée un souvenir inoubliable, bien au-delà de ce qu’une simple page de signatures pourrait transmettre.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
