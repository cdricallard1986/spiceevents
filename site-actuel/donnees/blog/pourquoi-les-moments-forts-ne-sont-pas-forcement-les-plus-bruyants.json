     "id": "3a27cddb-bdb6-4b90-a6d0-4974cec4a887",
     "defaultValue": false,
     "value": "<p class=\" p3\" style=\"text-align: justify;\"><span style=\"color: #000000;\"><strong>Une mise en scène sonore au service de l’événement</strong></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "102fed65-eaec-4ccb-8358-830b1500bf31",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "b9d8d193-705f-4bc4-bc7e-819d035c8503",
     "defaultValue": false,
     "value": "<p class=\" p3\" style=\"text-align: justify;\"><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/performances-techniques-son-and-lumieres\" data-type=\"undefined\" target=\"_self\"><u>La technique</u></a></span><span style=\"color: #000000;\"> est là pour servir le moment, pas pour le dominer. Une voix claire pendant une cérémonie, une musique douce lors d’un discours, une montée progressive pour une entrée ou une ouverture de bal… Chaque choix sonore participe à la narration globale de l’événement.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
