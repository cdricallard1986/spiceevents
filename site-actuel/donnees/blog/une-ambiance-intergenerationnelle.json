     "id": "29d88a2d-a5a1-4f9f-aa83-048bf273232c",
     "defaultValue": false,
     "value": "<p class=\" p2\" style=\"text-align: justify;\"><span style=\"display: inline-block\"></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "cbfe4bb2-0d5e-48b3-9b01-173fdbcaf9bb",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "63ccc4c2-d687-4b5f-81e7-09af4566dbc5",
     "defaultValue": false,
     "value": "<p class=\" p1\" style=\"text-align: justify;\"><span style=\"color: #000000;\"><strong>Créer du souvenir collectif</strong></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "7db44e13-348c-409e-8bb1-ce2adcc3982c",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "87f515aa-a358-490b-9fd2-22b56268fdab",
     "defaultValue": false,
     "value": "<p class=\" p1\" style=\"text-align: justify;\"><span style=\"color: #000000;\">Quand plusieurs générations dansent ensemble, l’événement change de dimension. Parents et enfants partagent un moment commun, des souvenirs se créent, des barrières tombent. C’est là que l’ambiance devient mémorable : quand la musique rassemble au lieu de diviser.</span><br></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
