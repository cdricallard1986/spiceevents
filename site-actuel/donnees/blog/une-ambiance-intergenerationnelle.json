   },
   {
    "type": "Blog.Section",
    "id": "618ed0a5-c2bb-450a-9dd2-816d2f10d95c",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "caa8b86f-d0ac-4474-a917-0677c837404e",
     "defaultValue": false,
     "value": "<p class=\" p1\" style=\"text-align: justify;\"><span style=\"color: #000000;\"><strong>Conclusion : l’ambiance comme langage universel</strong></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "19ae04ff-aacd-4484-b3b8-5785c24a99e5",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "4646e49d-1055-453b-a873-7e5d1c4bedad",
     "defaultValue": false,
     "value": "<p class=\" p1\" style=\"text-align: justify;\"><span style=\"color: #000000;\">Une ambiance intergénérationnelle réussie n’est pas un compromis, c’est une exigence. Elle demande de la culture musicale, de l’expérience et une vraie sensibilité humaine. Mais quand elle fonctionne, elle transforme une simple soirée en moment fédérateur. Et c’est précisément là que l’événementiel prend tout son sens.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
