   {
    "type": "Blog.Section",
    "id": "d869b583-a3e5-4329-b39f-471b099d609d",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "844d4107-60f0-4956-96b3-1718d761e13d",
     "defaultValue": false,
     "value": "<p class=\" p1\" style=\"text-align: justify;\"><span style=\"color: #000000;\"><strong>Le secret : la narration musicale</strong></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "7ec7e2e0-f0e0-4f81-9f35-d44fbd0029a2",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "f86db333-805a-49ab-bfe6-505960ab12c0",
     "defaultValue": false,
     "value": "<p class=\" p1\" style=\"text-align: justify;\"><span style=\"color: #000000;\">Une ambiance intergénérationnelle réussie repose sur une narration fluide. Un classique intemporel peut ouvrir la porte à un titre plus récent. Un hit actuel peut être réarrangé ou mixé avec une référence des années 80 ou 90. Ce jeu d’équilibre évite les ruptures et maintient tout le monde sur la piste, sans frustration ni lassitude.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "bff5e5d4-6033-44e8-b9a0-dcd6052f98fa",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "f1707e75-c45f-44d1-bee6-84ea98c4450d",
     "defaultValue": false,
     "value": "<p class=\" p2\" style=\"text-align: justify;\"><br></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "51b51da4-bc91-4aec-8d62-7275bd63470a",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "c258d282-a244-476a-9fae-b834dec3a1ec",
     "defaultValue": false,
     "value": "<p class=\" p1\" style=\"text-align: justify;\"><span style=\"color: #000000;\"><strong>Le respect du dancefloor</strong></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "12a35fb1-18b1-4201-aa65-2759c253c2de",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "dc692351-efc7-499b-ab7c-b385f56cf63d",
     "defaultValue": false,
     "value": "<p class=\" p1\" style=\"text-align: justify;\"><span style=\"color: #000000;\">Faire plaisir à tous, ce n’est pas tout jouer. C’est savoir quand jouer quoi. Le respect du dancefloor passe par l’observation : qui danse, qui s’essouffle, qui arrive, qui repart (</span><span style=\"color: #666666;\"><a style=\"color: #666666;\" href=\"https://www.spiceevents.fr/blog/comment-un-dj-lit-il-une-piste-de-danse\" data-type=\"\" target=\"_blank\"><u><em>voir article : Comment un DJ lit-il une piste de danse ?</em></u></a></span><span style=\"color: #000000;\">). Une ambiance intergénérationnelle ne sacrifie jamais une génération pour en satisfaire une autre. Elle évolue, respire, s’adapte.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
