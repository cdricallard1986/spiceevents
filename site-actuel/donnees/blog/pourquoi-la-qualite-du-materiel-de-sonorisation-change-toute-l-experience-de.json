  "sections": [
   {
    "type": "Blog.Section",
    "id": "a4a8919f-2ec0-4ca2-beeb-d3ed5d1843d4",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "b08b5dc2-53c7-4263-b60f-b917d609a1eb",
     "defaultValue": false,
     "value": "<p><span style=\"color: #000000;\">Lors d’un </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/mariages\" data-type=\"undefined\" target=\"_self\"><u>mariage</u></a></span><span style=\"color: #000000;\"> ou d’un </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/evenementiel\" data-type=\"undefined\" target=\"_self\"><u>événement</u></a></span><span style=\"color: #000000;\">, le son est un élément central… et pourtant, lorsqu’il est parfaitement maîtrisé, il se fait oublier. Une </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/performances-techniques-son-and-lumieres\" data-type=\"undefined\" target=\"_self\"><u>sonorisation de qualité</u></a></span><span style=\"color: #000000;\"> ne se remarque pas : elle se ressent. Elle accompagne les émotions, soutient les temps forts et garantit une expérience fluide pour tous les invités. À l’inverse, un matériel inadapté peut rapidement nuire à l’ambiance, même avec la meilleure programmation musicale.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "ebc23aa0-24d0-40eb-8ebe-64386ef2a73a",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "f560b718-ad6b-4c8b-afcd-7209ce88810e",
     "defaultValue": false,
     "value": "<p class=\" p3\"><br></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "abf970ee-a0e8-43cc-b0c7-96fa69c635d9",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "67416d96-2789-439b-827e-6d46f8d0cec0",
     "defaultValue": false,
     "value": "<p class=\" p1\"><span style=\"color: #000000;\"><strong>Un son clair, homogène et confortable pour tous</strong></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "576ee692-2639-45f4-9c2c-f1c948b30aea",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "c9db72e7-00a5-4597-b6f7-f9819fe33de6",
     "defaultValue": false,
     "value": "<p class=\" p1\"><span style=\"color: #000000;\">La qualité du matériel de sonorisation est essentielle pour assurer une écoute agréable et intelligible. Discours, cérémonie laïque, interventions parlées ou musique : chaque mot et chaque note doivent être audibles, sans saturation ni déséquilibre sonore. Chez S</span><span style=\"color: #000000;\"><strong>pice Events,</strong></span><span style=\"color: #000000;\"> nous accordons une importance particulière à l’</span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/performances-techniques-son-and-lumieres\" data-type=\"undefined\" target=\"_self\"><u>exigence technique</u></a></span><span style=\"color: #000000;\">, en nous appuyant notamment sur le matériel professionnel de </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://mxevenement.com/\" data-type=\"undefined\" target=\"_self\"><u><strong>M</strong></u></a></span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://mxevenement.com/\" data-type=\"undefined\" target=\"_self\"><u><strong>X ÉVÈNEMENT</strong></u></a></span><span style=\"color: #000000;\"><strong>,</strong></span><span style=\"color: #000000;\"> reconnu pour la fiabilité et la </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/performances-techniques-son-and-lumieres\" data-type=\"undefined\" target=\"_self\"><u>performance de ses équipements</u></a></span><span style=\"color: #000000;\">.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
