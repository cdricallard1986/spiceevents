   },
   {
    "type": "Blog.Section",
    "id": "83e9837a-570d-4654-a340-f2c1c9931a00",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "33be6915-2482-428c-aa04-c4a7666c439e",
     "defaultValue": false,
     "value": "<p class=\" p1\"><span style=\"color: #000000;\"><strong>La technique au service de l’émotion</strong></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "785c9d33-b6a2-4245-b598-0aa968fefbe3",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "8fc86ecb-7947-45d4-8b00-daf99fd5e5e5",
     "defaultValue": false,
     "value": "<p class=\" p1\"><span style=\"color: #000000;\">La sonorisation doit soutenir l’émotion, jamais la voler. Lorsqu’elle est de qualité, elle s’efface pour laisser place aux instants forts : un discours émouvant, une musique partagée, une piste de danse qui se remplit naturellement. C’est cette vision que défend S</span><span style=\"color: #000000;\"><strong>pice Events </strong></span><span style=\"color: #000000;\">: une </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/performances-techniques-son-and-lumieres\" data-type=\"undefined\" target=\"_self\"><u>technique exigeante</u></a></span><span style=\"color: #000000;\">, discrète et fiable, inspirée des standards professionnels de </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://mxevenement.com/\" data-type=\"undefined\" target=\"_self\"><u><strong>M</strong></u></a></span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://mxevenement.com/\" data-type=\"undefined\" target=\"_self\"><u><strong>X ÉVÈNEMENT,</strong></u></a></span><span style=\"color: #000000;\"> pour faire vivre une expérience sonore fluide, élégante et mémorable.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
