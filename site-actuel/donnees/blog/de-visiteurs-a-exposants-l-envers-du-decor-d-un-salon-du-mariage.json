     "id": "f9c6ea0c-7083-485a-a574-6042a840e3ec",
     "defaultValue": false,
     "value": "<p class=\" s1 p1\" style=\"text-align: justify;\"><span style=\"color: #000000;\">Parce qu’un événement réussi repose sur la rigueur et un </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/accompagnement\" data-type=\"undefined\" target=\"_self\"><u>accompagnement personalisé</u></a></span><span style=\"color: #000000;\">. Et cette rigueur, </span><span style=\"color: #000000;\"><strong>Spice Events</strong></span><span style=\"color: #000000;\"> la mettra au cœur de votre </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/mariages\" data-type=\"undefined\" target=\"_self\"><u>mariage</u></a></span><span style=\"color: #000000;\"> !</span><span style=\"color: #000000;\"><br></span></p>",
     "backupValue": null,
     "version": 1,
