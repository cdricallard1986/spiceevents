     "id": "a8fbe4f6-4d5e-40c5-a054-3f5fdc25346b",
     "defaultValue": false,
     "value": "<p style=\"text-align: center; font-size: 20px;\"><span style=\"color: #000000;\"><strong>Thématique sur-mesure. </strong></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "19fdeac7-92da-4c95-bf08-dd29d828cf24",
    "defaultValue": null,
    "component": {
     "type": "Image",
