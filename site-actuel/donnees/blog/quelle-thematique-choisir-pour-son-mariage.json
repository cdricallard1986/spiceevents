    }
   },
   {
    "type": "Blog.Section",
    "id": "a8dec2a4-98a1-4aac-b994-30047aff5149",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "919bf982-69e2-4983-a634-23121e8fe9e4",
