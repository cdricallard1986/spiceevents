  "sections": [
   {
    "type": "Blog.Section",
    "id": "08596def-982d-4856-a906-a556e4658ffb",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "a4b030a9-7604-402e-bcd7-88ec417b5192",
     "defaultValue": false,
     "value": "<p><span style=\"color: #000000;\">Un mariage oui, mais responsable de l’environnement, c’est encore mieux. Soucieux de mettre l’écologie au cœur de notre profession, chez Spice Events, nous développons régulièrement nos offres pour vous offrir des événements encore plus époustouflant les uns que les autres. </span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "67c8d1f0-78f6-4dec-97f4-385c262f897b",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "37574290-d7ef-454a-baf2-5b15cc8acfd9",
     "defaultValue": false,
     "value": "<p><span style=\"color: #000000;\">A l’heure où l’environnement devient un sujet de plus en plus préoccupant, nous cherchons sans cesse à nous renouveler tout en gardant la qualité de notre prestation : éclairage LED, traiteur favorisant le circuit-court…</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "19678364-795d-4200-8de1-f1d45d45a5d1",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "4046879d-7df3-4c39-9b85-86aa34bbf25f",
     "defaultValue": false,
     "value": "<p><span style=\"color: #000000;\"><em>On vous en dit un peu plus sur ces options green qui font du bien à la planète ! </em></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "19678364-795d-4200-8de1-f1d45d45a5d1",
