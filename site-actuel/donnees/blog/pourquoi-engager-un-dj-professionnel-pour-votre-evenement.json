   },
   {
    "type": "Blog.Section",
    "id": "29b57cb5-0db2-45b2-9555-bf3da8650041",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "470ffd8c-594a-4fa9-b701-7126e2d88286",
     "defaultValue": false,
     "value": "<p style=\"text-align: center; font-size: 20px;\"><span style=\"color: #000000;\"><strong>Un matériel de pro</strong></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "3f54a3eb-7040-425c-a367-58182a029b0c",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "ac93353a-0d02-49d4-9846-732fa9789102",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\">En plus de disposer d’un bon matériel, un </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/booking-dj\" data-type=\"\" target=\"_self\"><u>DJ</u></a></span> <span style=\"color: #000000;\">professionnel le connaît et saura créer l’ambiance que vous désirez. En avance, il pourra prévoir les enchaînements entre les musiques, les </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/animations-tendances\" data-type=\"\" target=\"_self\"><u>animations</u></a></span><span style=\"color: #000000;\">, les passages micros ou encore</span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/performances-techniques-son-and-lumieres\" data-type=\"undefined\" target=\"_self\"> </a></span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/performances-techniques-son-and-lumieres\" data-type=\"undefined\" target=\"_self\"><u>l’éclairage</u></a></span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/performances-techniques-son-and-lumieres\" data-type=\"undefined\" target=\"_self\"> </a></span><span style=\"color: #000000;\">en fonction de votre lieu de réception et des musiques. Nos </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"http://www.spiceevents.fr/booking-dj\" data-type=\"undefined\" target=\"_self\"><u>DJ</u></a></span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"http://www.spiceevents.fr/booking-dj\" data-type=\"undefined\" target=\"_self\"> </a></span><span style=\"color: #000000;\">utilisent du matériel haut de gamme fournit par </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"http://www.mxevenement.com\" data-type=\"undefined\" target=\"_self\"><u>MX EVENEMENT</u></a></span><span style=\"color: #000000;\">.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
