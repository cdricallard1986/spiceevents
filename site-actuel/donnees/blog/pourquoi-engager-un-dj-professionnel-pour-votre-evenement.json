     "id": "85872693-0c10-468e-9017-df0626771b5a",
     "defaultValue": false,
     "value": "<p style=\"text-align: center; font-size: 20px;\"><span style=\"color: #000000;\"><strong>Une adaptation à toute épreuve</strong></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "71cfb1ef-a2cc-42a2-93bd-91b388effd30",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "976b5200-78a3-4ee0-beec-16014ec24a09",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\">Parce que c’est son métier, un </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/booking-dj\" data-type=\"\" target=\"_self\"><u>DJ</u></a></span> <span style=\"color: #000000;\">saura faire le mixage idéal pour faire plaisir à toutes les personnes présentes et mélanger les différents styles. </span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "a9009cd3-3cca-44d6-903c-0f8ede9472d7",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "0722df22-d28e-4695-bc4a-6d4f7ab3cf72",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\">Qu’il y ait des fans de rock, rap, hip hop, électro ou encore de reggae, ce n’est pas un problème car votre </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/booking-dj\" data-type=\"undefined\" target=\"_self\"><u>DJ</u></a></span><span style=\"color: #000000;\"> se débrouillera pour vous satisfaire ! </span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "722045e5-0640-4c67-a358-0261e8867cd4",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "80145fef-0e2d-47bf-acf7-735aa8cca1b5",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\">Alors filez sur la piste et appréciez le moment !</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "722045e5-0640-4c67-a358-0261e8867cd4",
