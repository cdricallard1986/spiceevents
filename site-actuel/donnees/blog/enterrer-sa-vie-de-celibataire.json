    "component": {
     "type": "RichText",
     "id": "8d3e7a52-9335-456c-8011-0d69215e15fa",
     "defaultValue": false,
     "value": "<p style=\"text-align: center; font-size: 20px;\"><span style=\"color: #000000;\"><strong>Laissez-vous transporter</strong></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "9256bd82-423c-4a3b-b13c-55e644c6c715",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "d4fd5daa-c209-4ce9-8d7e-99d70ee54a20",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify; font-size: 100%;\"><span style=\"color: #000000;\">Pour un enterrement de vie de célibataire, il existe d’autres animations que celle des fameux/ses gogo-danseur/ses. Alors si vous souhaitez en avoir pleins les yeux lors de cette journée sans passer par là, Spice Events vous propose de vous rendre sur sa page </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/booking-dj\" data-type=\"undefined\" target=\"_self\"><u>booking DJ</u></a></span><span style=\"color: #000000;\"> et de vous laisser emporter par la musique !</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "9256bd82-423c-4a3b-b13c-55e644c6c715",
    "defaultValue": null,
    "component": {
