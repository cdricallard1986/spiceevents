     "id": "c24c43e2-a3fd-419c-a1b9-3474cfe4ec99",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify; font-size: 100%;\"><span style=\"color: #000000;\"><strong>L’approche Spice Events</strong></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "692b7578-d54c-4d4d-8c3e-6b17368f0f6c",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "0d90aed9-22a6-4692-8459-e2812976168a",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify; font-size: 100%;\"><span style=\"color: #000000;\">Chez </span><span style=\"color: #000000;\"><strong>Spice Events</strong></span><span style=\"color: #000000;\">, les </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/animations-tendances\" data-type=\"undefined\" target=\"_self\"><u>animation</u></a></span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/animations-tendances\" data-type=\"undefined\" target=\"_self\"><u>s tendanc</u></a></span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/animations-tendances\" data-type=\"undefined\" target=\"_self\"><u>es</u></a></span><span style=\"color: #000000;\"> sont proposées comme des leviers d’ambiance ciblés et non comme une accumulation systématique. </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/photobooth\" data-type=\"undefined\" target=\"_self\"><u>Photobooth</u></a></span><span style=\"color: #000000;\">, </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/bar-a-vinyles\" data-type=\"undefined\" target=\"_self\"><u>bar à vinyles</u></a></span><span style=\"color: #000000;\"> ou autres concepts sont intégrés de manière réfléchie pour renforcer l’expérience sans nuire au rythme de la soirée. Chaque recommandation tient compte du lieu, du nombre d’invités, du style recherché et du déroulé global.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "692b7578-d54c-4d4d-8c3e-6b17368f0f6c",
