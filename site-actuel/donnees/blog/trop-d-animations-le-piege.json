  "sections": [
   {
    "type": "Blog.Section",
    "id": "b97271e6-a7e3-4ba3-9a01-64eaa786e678",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "a760c711-7a60-4eca-9a93-841e78c1a326",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify; font-size: 100%;\"><span style=\"color: #000000;\">Lors de la préparation d’un </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/mariages\" data-type=\"undefined\" target=\"_self\"><u>mariage</u></a></span><span style=\"color: #000000;\"> ou d’un </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/evenementiel\" data-type=\"undefined\" target=\"_self\"><u>événement</u></a></span><span style=\"color: #000000;\">, il est naturel de vouloir surprendre et divertir ses invités. </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/photobooth\" data-type=\"undefined\" target=\"_self\"><u>Photobooth</u></a></span><span style=\"color: #000000;\">, </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/bar-a-vinyles\" data-type=\"undefined\" target=\"_self\"><u>bar à vinyles</u></a></span><span style=\"color: #000000;\">, </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/livre-d-or-audio\" data-type=\"undefined\" target=\"_self\"><u>livre d'or audio</u></a></span><span style=\"color: #000000;\">, </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/guirlandes-lumineuses\" data-type=\"undefined\" target=\"_self\"><u>guirlandes lumineuses</u></a></span><span style=\"color: #000000;\"> ou autres </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/animations-tendances\" data-type=\"undefined\" target=\"_self\"><u>animations</u></a></span><span style=\"color: #000000;\"> : les possibilités sont nombreuses et séduisantes. Pourtant, multiplier les </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/animations-tendances\" data-type=\"undefined\" target=\"_self\"><u>animations</u></a></span><span style=\"color: #000000;\"> sans véritable stratégie peut produire l’effet inverse de celui recherché. Chez </span><span style=\"color: #000000;\"><strong>Spice Events</strong></span><span style=\"color: #000000;\">, nous observons régulièrement qu’un excès d’</span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/animations-tendances\" data-type=\"undefined\" target=\"_self\"><u>animations </u></a></span><span style=\"color: #000000;\">nuit à la fluidité et à l’impact global de la soirée.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
