   },
   {
    "type": "Blog.Section",
    "id": "54cfa130-1799-4e2a-87e1-91f4a1bddb69",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "19be98c8-c4a7-4b2d-bc99-80fe8999fc83",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify; font-size: 100%;\"><span style=\"color: #000000;\"><strong>La qualité prime toujours sur la quantité</strong></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "686e7dd7-782e-44c7-9599-a1c54f3442f9",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "0c6588a8-9422-4fb0-8ce6-941274234652",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify; font-size: 100%;\"><span style=\"color: #000000;\">Une </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/animations-tendances\" data-type=\"undefined\" target=\"_self\"><u>animation</u></a></span><span style=\"color: #000000;\"> bien choisie et parfaitement exécutée aura toujours plus d’impact que plusieurs </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/animations-tendances\" data-type=\"undefined\" target=\"_self\"><u>animations</u></a></span><span style=\"color: #000000;\"> moyennes. Un </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/photobooth\" data-type=\"undefined\" target=\"_self\"><u>photobooth</u></a></span><span style=\"color: #000000;\"> bien placé ou un </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/bar-a-vinyles\" data-type=\"undefined\" target=\"_self\"><u>bar à vinyles</u></a></span><span style=\"color: #000000;\"> peuvent devenir de véritables points d’attractions et générer des souvenirs forts. À l’inverse, multiplier les dispositifs peut diluer l’attention et créer une impression de dispersion. L’enjeu est donc de sélectionner les </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/animations-tendances\" data-type=\"undefined\" target=\"_self\"><u>animations</u></a></span><span style=\"color: #000000;\"> en fonction du profil des invités, du lieu et du timing global.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
