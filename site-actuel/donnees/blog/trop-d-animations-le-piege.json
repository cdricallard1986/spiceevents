    }
   },
   {
    "type": "Blog.Section",
    "id": "7e7990e7-b6ee-4f26-a4fa-265790b1937b",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "76fcd2e2-cdd9-4a81-96f2-8cc61fef7956",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify; font-size: 100%;\"><span style=\"color: #000000;\"><strong>Trouver le juste équilibre</strong></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "c90a3a24-754b-4fa8-a51e-a6ed70dc8cd3",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "d651f60c-7f5e-4100-9d51-19eb171fe6c8",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify; font-size: 100%;\"><span style=\"color: #000000;\">Une soirée mémorable n’est pas celle qui propose le plus d’</span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/animations-tendances\" data-type=\"undefined\" target=\"_self\"><u>animations</u></a></span><span style=\"color: #000000;\">, mais celle qui maintient l’attention et l’énergie des invités du début à la fin. Le bon équilibre repose sur une sélection pertinente, un timing maîtrisé et une vision d’ensemble cohérente. Bien dosées, les </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/animations-tendances\" data-type=\"undefined\" target=\"_self\"><u>animations</u></a></span><span style=\"color: #000000;\"> deviennent de véritables accélérateurs d’ambiance. Mal calibrées, elles peuvent au contraire fragmenter l’expérience.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
