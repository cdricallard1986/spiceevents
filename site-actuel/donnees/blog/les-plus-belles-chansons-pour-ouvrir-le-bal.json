    }
   },
   {
    "type": "Blog.Section",
    "id": "c7f8fc14-d6d5-46a8-bae5-5389ebd5a3ae",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "59d51a0f-5197-4b23-a3aa-a3123ca92e70",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #140e06;\">  </span><span style=\"color: #140e06;\"><strong> 4. Love Me Like You Do d' Ellie Goulding</strong></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "1e80c43f-6a94-41c4-8c20-b7f2f4e70c1d",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "8ea36c4f-d0cb-4548-9c93-fa61e984f42f",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\">Si vous souhaitez un peu plus de rythme pour pouvoir montrer vos grands talents de danse, opter pour cette chanson plus dynamique mais toujours très romantique d’Ellie Goulding. Encore un morceau rempli d’amour et de promesse. </span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "688d0bd1-4ff7-43e3-8c40-a14893c23743",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "d3c400af-d166-443b-ae4f-2718b31463c6",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\"><strong>   5. Je l’aime à mourir de Francis Cabrel</strong></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "1833fb4b-f27c-47b9-8d15-1486bbff4651",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "3943796e-99bf-4d13-aeec-c19324d81596",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\">Un peu plus ancienne que les autres musiques que nous vous avons proposées jusqu'ici, cette jolie chanson écrite par Francis Cabrel est une belle déclaration pour votre conjoint/e en ce jour si particulier. </span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "0f9ba14d-9736-4f42-a633-e4a3b9343b8b",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "024773cb-40cd-4c3a-9fb0-4be1fbe882fa",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\"><strong>   6. Just The Way You Are de Bruno Mars</strong></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "5cd0180e-8ecb-4bf3-9645-fcd0e6e74301",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "f56a3632-dda4-4d23-899b-e87baaa695ac",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\">Si vous et votre moitié vous vous aimez “just the way you are”, remerciez notre cher Bruno Mars pour ce single et empruntez lui juste le temps d’une danse. </span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "bd2bf919-20cd-4a7b-b55e-7afa7db5e4ab",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "858eea86-2c01-4c79-b245-eabd5860ab7c",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\"><strong>   7. All of me de John Legend</strong></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "07809c5f-f7a5-4f53-af90-514507e9df57",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "4f0d1f9d-31b8-436e-a5db-d40a9313375e",
     "defaultValue": false,
     "value": "<p style=\"text-align: justify;\"><span style=\"color: #000000;\">Autre très belle chanson symbole d’amour et de dévotion, cette chanson du talentueux John Legend qui saura vous emporter dans un moment magique et inoubliable. </span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
