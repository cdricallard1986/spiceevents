    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "2b218521-905a-46af-8f9d-3e141d2d6a74",
     "defaultValue": false,
     "value": "<p class=\" p1\" style=\"text-align: justify;\"><span style=\"color: #000000;\"><strong>Une approche globale signée Spice Events</strong></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "18406104-6ea1-4193-bd40-e8c0c5883421",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "d6a152cf-f955-47cb-93b2-45a98feaa6a5",
     "defaultValue": false,
     "value": "<p class=\" p1\" style=\"text-align: justify;\"><span style=\"color: #000000;\">C’est pourquoi </span><span style=\"color: #000000;\"><strong>Spice Events</strong></span><span style=\"color: #000000;\"> adopte une vision globale de chaque événement. </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/performances-techniques-son-and-lumieres\" data-type=\"undefined\" target=\"_self\"><u>La technique</u></a></span><span style=\"color: #000000;\">, l’animation et la structure de la soirée sont pensées ensemble, jamais séparément. Cette approche permet non seulement de sécuriser le bon déroulement du jour J, mais surtout de maximiser l’impact émotionnel après l’événement. Car ce sont bien les retours des invités, les messages reçus le lendemain et les souvenirs partagés qui mesurent la réussite réelle d’une soirée.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
