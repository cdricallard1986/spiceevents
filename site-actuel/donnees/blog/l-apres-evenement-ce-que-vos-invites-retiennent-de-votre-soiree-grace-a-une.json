    "component": {
     "type": "RichText",
     "id": "83c10a62-9094-4eb0-bd18-949f34c9b71a",
     "defaultValue": false,
     "value": "<p class=\" p1\"><span style=\"color: #000000;\"><strong>L’impact visuel de la lumière</strong></span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
   {
    "type": "Blog.Section",
    "id": "9a74a31d-539e-42d8-87c0-65b0d412fd2f",
    "defaultValue": null,
    "component": {
     "type": "RichText",
     "id": "a57f53d6-9051-4c02-af1b-ba7508361486",
     "defaultValue": false,
     "value": "<p class=\" p1\" style=\"text-align: justify;\"><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/performances-techniques-son-and-lumieres\" data-type=\"undefined\" target=\"_self\"><u>La lumière</u></a></span><span style=\"color: #000000;\"> joue également un rôle majeur dans la mémoire émotionnelle de vos invités. Avant même de se souvenir d’un morceau précis, ils retiennent une ambiance visuelle. Une </span><span style=\"color: #000000;\"><a style=\"color: #000000;\" href=\"https://www.spiceevents.fr/performances-techniques-son-and-lumieres\" data-type=\"undefined\" target=\"_self\"><u>mise en lumière cohérente</u></a></span><span style=\"color: #000000;\"> valorise le lieu de réception, accompagne les moments clés et soutient la montée en puissance de la soirée. Une lumière statique ou mal adaptée peut rapidement donner une impression plate, tandis qu’un éclairage évolutif crée une véritable dynamique. L’objectif n’est jamais d’en faire trop, mais de soutenir chaque moment avec justesse.</span></p>",
     "backupValue": null,
     "version": 1,
     "wrapperClass": "s-narrow-margin"
    }
   },
