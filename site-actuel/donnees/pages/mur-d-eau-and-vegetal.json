    },
    "text1": {
     "type": "RichText",
     "id": "f_55a15b95-28d8-45c0-a921-c52e2a8d488b",
     "defaultValue": false,
     "alignment": null,
     "value": "<div class=\"s-rich-text-wrapper\" style=\"display: block; \"><h1 class=\" s-rich-text-wrapper font-size-tag-header-one s-text-font-size-over-40\" style=\"font-size: 48px;\">Offrez une signature visuelle inoubliable</h1><p class=\" s-rich-text-wrapper font-size-tag-custom s-text-font-size-over-default\" style=\"font-size: 25px;\"><em>Des installations spectaculaires pour marquer les esprits</em></p><p class=\" s-rich-text-wrapper font-size-tag-custom s-text-font-size-over-default\" style=\"font-size: 25px;\"><span style=\"display: inline-block\"></span></p></div>",
     "backupValue": null,
     "version": 1,
     "defaultDataProcessed": true
    },
    "text2": {
     "type": "RichText",
     "id": "f_467e867b-a3e1-4d11-8f67-763f5bbb3d21",
     "defaultValue": false,
     "alignment": "justify",
     "value": "<div class=\"s-rich-text-wrapper\" style=\"display: block; \"><p class=\" s-rich-text-wrapper font-size-tag-custom s-text-font-size-over-default\" style=\"text-align: justify; font-size: 18px;\">Apportez une identité forte, élégante et immersive à vos <a href=\"http://www.spiceevents.fr/mariages\" data-type=\"undefined\" target=\"_self\">mariages</a>, cocktails, stands ou soirées d’entreprise grâce à nos murs d’eau et murs végétaux entièrement personnalisables. Ces décors créent une atmosphère unique dès l’arrivée de vos invités et transforment n’importe quel espace en une expérience visuelle marquante. Leur modularité permet de les intégrer parfaitement à vos espaces photo, à un <a href=\"http://www.spiceevents.fr/photobooth\" data-type=\"undefined\" target=\"_self\">photobooth</a>, à une zone d’accueil ou même à votre scénographie globale. </p></div>",
     "backupValue": null,
     "version": 1,
     "defaultDataProcessed": true
    },
