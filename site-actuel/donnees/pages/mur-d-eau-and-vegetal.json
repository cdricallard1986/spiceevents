  {
   "type": "Slide",
   "id": "f_775392ee-a299-47a2-8cae-6bee8a0a2c58",
   "defaultValue": true,
   "template_name": "cta",
   "components": {
    "slideSettings": {
     "type": "SlideSettings",
     "id": "f_cd73509a-e192-40a0-8c76-a62b6b30d59e",
     "defaultValue": true,
     "show_nav": true,
     "nameChanged": true,
     "hidden_section": false,
     "name": "Murs végétaux utilisation",
     "sync_key": null,
     "layout_variation": "center-bottom-normal"
    },
    "text1": {
     "type": "RichText",
     "id": "f_4f21ac6c-1a80-49e2-87e9-5b740461a8d3",
     "defaultValue": false,
     "alignment": null,
     "value": "<div class=\"s-rich-text-wrapper\" style=\"display: block; \"><h1 class=\" s-rich-text-wrapper font-size-tag-header-one s-text-font-size-over-40\" style=\"font-size: 48px;\">Nos murs végétaux</h1><p class=\" s-rich-text-wrapper font-size-tag-custom s-text-font-size-over-default\" style=\"font-size: 25px;\"><em>Un décor vivant, immersif et modulable</em></p></div>",
     "backupValue": null,
     "version": 1,
     "defaultDataProcessed": true
    },
    "text2": {
     "type": "RichText",
     "id": "f_0fb8051e-bba9-4ef3-8b56-cfb1055dda81",
     "defaultValue": false,
     "alignment": "justify",
     "value": "<div class=\"s-rich-text-wrapper\" style=\"display: block; \"><p class=\" s-rich-text-wrapper\" style=\"text-align: justify;\">Nos murs végétaux créent une ambiance fraîche, naturelle et moderne, idéale pour tous les événements. Ils peuvent être sublimés avec :</p><ul><li class=\" s-rich-text-wrapper\" style=\"text-align: justify;\">Des néons personnalisés (noms, slogans, dates, messages)</li><li class=\" s-rich-text-wrapper\" style=\"text-align: justify;\">Des stickers adaptés à votre thème ou identité visuelle</li><li class=\" s-rich-text-wrapper\" style=\"text-align: justify;\">Des éléments décoratifs ou floraux selon la saison</li></ul><p class=\" s-rich-text-wrapper\" style=\"text-align: justify;\"><span style=\"display: inline-block\"></span></p><p class=\" s-rich-text-wrapper\" style=\"text-align: justify;\">Ils sont parfaits pour :</p><ul><li class=\" s-rich-text-wrapper\" style=\"text-align: justify;\">Les zones photo et photocalls</li><li class=\" s-rich-text-wrapper\" style=\"text-align: justify;\">Les arrière-plans pour vos prises de parole ou interviews</li><li class=\" s-rich-text-wrapper\" style=\"text-align: justify;\">Les espaces dédiés au <a href=\"http://www.spiceevents.fr/photobooth\" data-type=\"undefined\" target=\"_self\">photobooth</a></li><li class=\" s-rich-text-wrapper\" style=\"text-align: justify;\">Les <a href=\"http://www.spiceevents.fr/mariages\" data-type=\"undefined\" target=\"_self\">mariages</a> naturels, élégants ou modernes</li><li class=\" s-rich-text-wrapper\" style=\"text-align: justify;\">Les stands <a href=\"http://www.spiceevents.fr/evenementiel\" data-type=\"undefined\" target=\"_self\">événementiels</a> souhaitant une touche premium</li></ul><p class=\" s-rich-text-wrapper\" style=\"text-align: justify;\"><span style=\"display: inline-block\"></span></p><p class=\" s-rich-text-wrapper\" style=\"text-align: justify;\">Nous vous <a href=\"http://www.spiceevents.fr/accompagnement\" data-type=\"undefined\" target=\"_self\">accompagnons</a> également pour harmoniser ce mur avec vos autres éléments visuels : des <a href=\"http://www.spiceevents.fr/guirlandes-lumineuses\" data-type=\"undefined\" target=\"_self\">guirlandes lumineuses</a>, des <a href=\"http://www.spiceevents.fr/animations-tendances\" data-type=\"undefined\" target=\"_self\">animations tendances</a>, mise en lumière ou décoration globale.</p></div>",
     "backupValue": null,
     "version": 1,
     "defaultDataProcessed": true
    },
