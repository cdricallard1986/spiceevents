  {
   "type": "Slide",
   "id": "f_67ad001b-dc81-41c1-b45d-d5e8fc98d07b",
   "defaultValue": true,
   "template_name": "cta",
   "components": {
    "slideSettings": {
     "type": "SlideSettings",
     "id": "f_753abf15-7f9f-4564-a0ab-439122eac2ee",
     "defaultValue": true,
     "show_nav": true,
     "nameChanged": true,
     "hidden_section": false,
     "name": "Murs végétaux utilisation",
     "sync_key": null,
     "layout_variation": "center-bottom-normal"
    },
    "text1": {
     "type": "RichText",
     "id": "f_34fc22f2-f658-4d62-81e8-3b409cb9d8f7",
     "defaultValue": false,
     "alignment": null,
     "value": "<div class=\"s-rich-text-wrapper\" style=\"display: block; \"><h1 class=\" s-rich-text-wrapper font-size-tag-header-one s-text-font-size-over-40\" style=\"font-size: 48px;\">Personalisation &amp; option </h1><p class=\" s-rich-text-wrapper font-size-tag-custom s-text-font-size-over-default\" style=\"font-size: 25px;\"><em>Stickers, néons et détails sur mesure</em></p><p class=\" s-rich-text-wrapper font-size-tag-custom s-text-font-size-over-default\" style=\"font-size: 25px;\"><span style=\"display: inline-block\"></span></p></div>",
     "backupValue": null,
     "version": 1,
     "defaultDataProcessed": true
    },
    "text2": {
     "type": "RichText",
     "id": "f_63de7f60-afc0-4643-aa2c-f3686ccd9a6e",
     "defaultValue": false,
     "alignment": "justify",
     "value": "<div class=\"s-rich-text-wrapper\" style=\"display: block; \"><p class=\" s-rich-text-wrapper\" style=\"text-align: justify;\">Chaque mur — d’eau ou végétal — peut être personnalisé pour refléter votre thème, votre identité visuelle ou l’ambiance que vous souhaitez créer.  Vous pouvez personnaliser votre mur avec :</p><p class=\" s-rich-text-wrapper\"><span style=\"display: inline-block\"></span></p><ul><li class=\" s-rich-text-wrapper\" style=\"text-align: justify;\"><u><strong>Stickers sur mesure </strong></u>: Initiales, logo d’entreprise, date clé, message ou motif décoratif adaptés à votre événement.</li><li class=\" s-rich-text-wrapper\" style=\"text-align: justify;\"><strong>Néons LED personnalisés</strong> : Parfait pour les murs végétaux : noms, slogans, hashtags ou messages lumineux qui deviennent un vrai point focal.</li><li class=\" s-rich-text-wrapper\" style=\"text-align: justify;\"><strong>Éléments décoratifs supplémentaires</strong> : Fleurs, végétation, accessoires assortis à votre thème pour harmoniser l’ensemble.</li></ul><p class=\" s-rich-text-wrapper\" style=\"text-align: justify;\">Nous vous <a href=\"http://www.spiceevents.fr/accompagnement\" data-type=\"undefined\" target=\"_self\">guidons</a> pour choisir l’endroit le plus esthétique et photogénique : derrière un <a href=\"http://www.spiceevents.fr/photobooth\" data-type=\"undefined\" target=\"_self\">photobooth</a>, en zone photo, en fond de stand ou pour vos prises de parole. Notre équipe vous <a href=\"http://www.spiceevents.fr/accompagnement\" data-type=\"undefined\" target=\"_self\">accompagne</a> dans le choix des couleurs, des matériaux, des effets lumineux et des options les plus harmonieuses. Nous veillons également à une installation sécurisée et parfaitement intégrée à vos autres éléments visuels, qu’il s’agisse de <a href=\"http://www.spiceevents.fr/mariages\" data-type=\"undefined\" target=\"_self\">mariages</a>, d’<a href=\"http://www.spiceevents.fr/evenementiel\" data-type=\"undefined\" target=\"_self\">événements</a> professionnel ou de scénographies plus complètes.</p></div>",
     "backupValue": null,
     "version": 1,
     "defaultDataProcessed": true
    },
    "text3": {
     "type": "RichText",
     "id": "f_9226990b-67de-4c87-bb99-1ead8e634651",
     "defaultValue": null,
     "value": "Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.",
     "backupValue": null,
     "version": null
    },
