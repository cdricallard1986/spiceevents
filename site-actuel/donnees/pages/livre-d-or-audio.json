                 "id": "f_2a070544-348f-42a2-931c-f2082df1c2fe",
                 "defaultValue": false,
                 "alignment": null,
                 "value": "<div class=\"s-rich-text-wrapper\" style=\"display: block; \"><h3 class=\" font-size-tag-header-three s-text-font-size-over-default\" style=\"font-size: 24px;\"><span style=\"color: var(--s-pre-color12);\"><em>Immortalisez les voix et les émotions de vos invités</em></span></h3></div>",
                 "backupValue": null,
                 "version": 1,
                 "defaultDataProcessed": true
                }
               }
              },
              {
               "type": "Spacer",
               "id": "f_686aab23-e2c1-4c58-9715-8cd3a4e7dc4a",
               "defaultValue": null,
               "value": "40"
              },
              {
               "type": "BlockComponentItem",
               "id": "f_b8b46b3b-c543-4451-9c0f-fc5bdc4faef6",
               "defaultValue": null,
               "name": "context",
               "components": {
                "text1": {
                 "type": "RichText",
                 "id": "f_6cb0b146-55dd-4794-998b-507c328af3e4",
                 "defaultValue": false,
                 "alignment": "justify",
                 "value": "<div class=\"s-rich-text-wrapper\" style=\"display: block; \"><h3 class=\" s-rich-text-wrapper font-size-tag-header-three s-text-font-size-over-default\" style=\"text-align: justify; font-size: 24px;\"><span style=\"color: #000000;\">Le livre d’or audio, c’est bien plus qu’un simple souvenir : c’est un concentré d’émotions, de rires et de voix capturées sur le moment. Vos proches décrochent le combiné, laissent un message, une anecdote ou une déclaration spontanée… et chaque mot devient un souvenir vivant. C’est une expérience originale, pleine d’authenticité, qui remplace avantageusement les traditionnels mots écrits. Chez Spice Events, nous installons et personnalisons votre téléphone pour qu’il s’accorde parfaitement à l’ambiance de votre événement. Résultat : un souvenir sonore unique, à réécouter encore et encore.</span></h3></div>",
                 "backupValue": null,
                 "version": 1,
                 "defaultDataProcessed": true
                }
               }
              }
             ],
