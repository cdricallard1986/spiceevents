     "id": "f_e1051dc3-d8ad-47b8-b60f-ffc075c11327",
     "defaultValue": false,
     "value": "<div class=\"s-rich-text-wrapper\" style=\"display: block;\"><h1 class=\" s-text-color-default s-rich-text-wrapper font-size-tag-header-one\" style=\"font-size: 48px;\"><span class=\"s-text-color-default\">Une présence discrète mais essentielle</span></h1><h3 class=\" s-text-color-default font-size-tag-header-three s-text-font-size-over-default\" style=\"font-size: 24px;\"><span class=\"s-text-color-default\"><em>Être là au bon moment, sans jamais s’imposer</em></span></h3></div>",
