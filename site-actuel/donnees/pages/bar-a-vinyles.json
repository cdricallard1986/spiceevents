    "text1": {
     "type": "RichText",
     "id": "f_d18d4390-7c37-45fb-a24e-f54d016035b7",
     "defaultValue": false,
     "alignment": "justify",
     "value": "<div class=\"s-rich-text-wrapper\" style=\"display: block; \"><h1 class=\" s-rich-text-wrapper font-size-tag-header-one s-text-font-size-over-40\" style=\"font-size: 48px;\">Pourquoi choisir le bar à vinyles ?</h1><h1 class=\" s-rich-text-wrapper font-size-tag-header-one s-text-font-size-over-40\" style=\"font-size: 48px;\"><span style=\"display: inline-block\"></span></h1><p class=\" s-rich-text-wrapper font-size-tag-custom s-text-font-size-over-default\" style=\"text-align: justify; font-size: 18px;\">Le Bar à Vinyles, c’est bien plus qu’une animation musicale : c’est une expérience interactive et fédératrice. Vos invités plongent dans l’univers du vinyle, choisissent leurs morceaux et participent à la création de l’ambiance. Une idée originale qui allie nostalgie, élégance et convivialité, idéale pour tous vos événements :</p></div>",
     "backupValue": null,
     "version": 1,
     "defaultDataProcessed": true
    },
    "text2": {
     "type": "RichText",
     "id": "f_83b944bf-44a3-409e-82b1-b191ce0b6751",
     "defaultValue": false,
     "alignment": "left",
     "value": "<div class=\"s-rich-text-wrapper\" style=\"display: block; \"><ul><li class=\" s-rich-text-wrapper font-size-tag-custom s-text-font-size-over-default\" style=\"text-align: left; font-size: 18px;\">Animation originale et participative</li><li class=\" font-size-tag-custom s-text-font-size-over-default\" style=\"text-align: left; font-size: 18px;\">Interaction entre les invités et la musique</li><li class=\" font-size-tag-custom s-text-font-size-over-default\" style=\"text-align: left; font-size: 18px;\">Ambiance conviviale et chaleureuse</li><li class=\" font-size-tag-custom s-text-font-size-over-default\" style=\"text-align: left; font-size: 18px;\">DJ professionnel pour un rendu impeccable</li></ul></div>",
     "backupValue": null,
     "version": 1,
     "defaultDataProcessed": true
    },
