   "components": {
    "slideSettings": {
     "type": "SlideSettings",
     "id": "f_22368fe5-f3aa-4c4a-b67d-76a2b1e6c47a",
     "defaultValue": null,
     "show_nav": true,
     "nameChanged": true,
     "hidden_section": false,
     "name": "Titre",
     "sync_key": null,
     "layout_variation": "center-bottom-full",
