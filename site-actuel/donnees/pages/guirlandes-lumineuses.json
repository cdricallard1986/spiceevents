              {
               "type": "BlockComponentItem",
               "id": "f_e6d9944e-2e4c-4bab-a287-9beb0765e31b",
               "defaultValue": null,
               "name": "context",
               "components": {
                "text1": {
                 "type": "RichText",
                 "id": "f_3672ae40-e193-4344-adf7-7cf3db87a724",
                 "defaultValue": false,
                 "value": "<div class=\"s-rich-text-wrapper\" style=\"display: block; \"><h3 class=\" s-rich-text-wrapper font-size-tag-header-three s-text-font-size-over-default\" style=\"text-align: justify; font-size: 24px;\"><span style=\"color: #000000;\">Les guirlandes lumineuses apportent une touche de magie et de chaleur à tous vos événements. Mariages, soirées privées ou événements professionnels, elles transforment n’importe quel espace en un lieu élégant, accueillant et mémorable. Installées au-dessus de la piste de danse, le long des murs ou pour sublimer des zones spécifiques comme les buffets ou la scène, chaque guirlande est pensée pour créer une ambiance unique et immersive. Nos équipes adaptent la disposition et l’intensité lumineuse selon la configuration de votre lieu, en intérieur comme en extérieur, pour un rendu harmonieux et sécurisé. Avec cette installation, vos invités se sentiront plongés dans une atmosphère conviviale et féérique, parfaite pour profiter pleinement de chaque instant. </span></h3></div>",
                 "backupValue": null,
                 "version": 1,
                 "lineAlignment": {
                  "firstLineTextAlign": "justify",
                  "lastLineTextAlign": "justify"
                 },
                 "defaultDataProcessed": true
