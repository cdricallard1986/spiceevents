     "id": "f_d3c0c63e-ce79-44c0-bf19-be8c9ebc108d",
     "defaultValue": false,
     "alignment": null,
     "value": "<div class=\"s-rich-text-wrapper\" style=\"display: block;\"><h1 class=\" s-text-color-default s-rich-text-wrapper font-size-tag-header-one\" style=\"font-size: 48px;\"><span class=\"s-text-color-default\">Idées d'utilisation</span></h1></div>",
     "backupValue": null,
     "version": 1,
     "lineAlignment": {
      "firstLineTextAlign": null,
      "lastLineTextAlign": null
     },
     "defaultDataProcessed": true
    },
    "text2": {
     "type": "RichText",
     "id": "f_7ad35229-73c8-4e09-80fa-9dab03b67d58",
     "defaultValue": false,
     "value": "<div class=\"s-rich-text-wrapper\" style=\"display: block; \"><p class=\" s-rich-text-wrapper\" style=\"text-align: justify;\">Les guirlandes lumineuses sont bien plus qu’un simple éclairage : ce sont de véritables éléments de mise en scène. Elles s’adaptent à toutes les ambiances et permettent de sublimer chaque moment de votre événement. Que ce soit pour créer une atmosphère romantique, chaleureuse ou festive, voici comment les intégrer à votre décor pour qu'elles apportent cette touche visuelle qui transforme un lieu ordinaire en décor inoubliable :</p><ul><li class=\" s-rich-text-wrapper\" style=\"text-align: justify;\"><strong>Cocktail et réception</strong> : créez des zones conviviales et chaleureuses,</li><li style=\"text-align: justify;\"><strong>Dîner et banquet</strong> : ajoutez une touche intimiste à vos tables et espaces,</li><li style=\"text-align: justify;\"><strong>Piste de danse</strong> : mettez en valeur le centre de votre événement,</li><li class=\" s-rich-text-wrapper\" style=\"text-align: justify;\"><strong>Espaces extérieurs</strong> : guirlandes résistantes et adaptées aux terrasses ou jardins.</li></ul></div>",
     "backupValue": null,
     "version": 1,
     "lineAlignment": {
      "firstLineTextAlign": "justify",
      "lastLineTextAlign": "justify"
     },
     "defaultDataProcessed": true
    },
