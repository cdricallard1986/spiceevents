     }
    },
    "text1": {
     "type": "RichText",
     "id": "f_53b4501f-1c65-40e4-bc3a-669d9547f0fe",
     "defaultValue": false,
     "value": "<div class=\"s-rich-text-wrapper\" style=\"display: block; \"><h3 class=\" s-text-color-default s-rich-text-wrapper font-size-tag-custom s-text-font-size-over-default font-size-tag-header-three\" style=\"text-align: center; font-size: 24px;\"><span style=\"color: #000000;\">DJ généraliste - Mariages &amp; événements</span></h3></div>",
     "backupValue": null,
     "version": 1,
     "lineAlignment": {
      "firstLineTextAlign": "center",
      "lastLineTextAlign": "center"
     },
     "defaultDataProcessed": true
    },
    "text2": {
     "type": "RichText",
     "id": "f_2b6158b6-4fe4-4bf9-b9da-de66c45b0c5a",
     "defaultValue": false,
     "value": "<div class=\"s-rich-text-wrapper\" style=\"display: block; \"><p class=\" font-size-tag- s-text-font-size-over-default s-rich-text-wrapper\" style=\"text-align: justify; font-size: unset;\"><span style=\"color: #000000;\">Chez Spice Events, nous ne cherchons pas simplement des DJ. Nous cherchons des personnalités, capables de créer des ambiances, de comprendre les émotions et d’accompagner des mariés tout au long de leur journée. Si vous aimez la musique, le contact humain et le travail bien fait, vous êtes  au bon endroit.</span></p><p class=\" font-size-tag- s-text-font-size-over-default s-rich-text-wrapper\" style=\"text-align: justify; font-size: unset;\"><span style=\"display: inline-block\"></span></p><p class=\" font-size-tag- s-text-font-size-over-default s-rich-text-wrapper\" style=\"text-align: center; font-size: unset;\"><span style=\"color: #000000;\"><strong>Le profil que nous recherchons</strong></span></p><p class=\" font-size-tag- s-text-font-size-over-default s-rich-text-wrapper\" style=\"text-align: center; font-size: unset;\"><span style=\"display: inline-block\"></span></p><p class=\" font-size-tag- s-text-font-size-over-default s-rich-text-wrapper\" style=\"text-align: justify; font-size: unset;\"><span style=\"color: #000000;\">En tant que DJ généraliste, vous interviendrez sur des mariages et événements aux univers variés. Votre mission : faire vivre la piste de danse, mais aussi être un véritable partenaire des mariés et des prestataires.</span></p><p class=\" font-size-tag- s-text-font-size-over-default s-rich-text-wrapper\" style=\"text-align: left; font-size: unset;\"><br><span style=\"color: #000000;\"><u>Vous êtes fait(e) pour ce poste si :</u></span></p><ul><li class=\" font-size-tag- s-text-font-size-over-default\" style=\"text-align: justify; font-size: unset;\"><span style=\"color: #000000;\">Vous êtes DJ généraliste, à l’aise avec tous les styles et générations</span></li><li class=\" font-size-tag- s-text-font-size-over-default\" style=\"text-align: justify; font-size: unset;\"><span style=\"color: #000000;\">Vous savez lire une piste de danse et ajuster votre set</span></li><li class=\" font-size-tag- s-text-font-size-over-default\" style=\"text-align: justify; font-size: unset;\"><span style=\"color: #000000;\">Vous avez un bon relationnel client et une attitude rassurante</span></li><li class=\" font-size-tag- s-text-font-size-over-default\" style=\"text-align: justify; font-size: unset;\"><span style=\"color: #000000;\">Vous êtes à l’aise à l’oral et en visio</span></li><li class=\" font-size-tag- s-text-font-size-over-default\" style=\"text-align: justify; font-size: unset;\"><span style=\"color: #000000;\">Vous avez des bases techniques (son / lumière) ou l’envie d’apprendre</span></li><li class=\" font-size-tag- s-text-font-size-over-default\" style=\"text-align: justify; font-size: unset;\"><span style=\"color: #000000;\">Vous êtes fiable, ponctuel(le) et impliqué(e)</span></li></ul></div>",
     "backupValue": null,
     "version": 1,
     "lineAlignment": {
      "firstLineTextAlign": "justify",
      "lastLineTextAlign": "justify"
     },
     "defaultDataProcessed": true
    },
