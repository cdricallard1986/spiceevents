  {
   "type": "Slide",
   "id": "f_9972409d-4589-43a1-81aa-134d4b10a594",
   "defaultValue": null,
   "template_name": "title",
   "components": {
    "slideSettings": {
     "type": "SlideSettings",
     "id": "f_134779a6-62f5-4fff-98f9-be3e1a42da20",
     "defaultValue": null,
     "show_nav": true,
     "nameChanged": true,
     "hidden_section": false,
     "name": "Titre",
     "sync_key": null,
     "layout_variation": "center-bottom-full",
     "padding": {
      "top": "normal",
      "bottom": "normal"
     }
    },
    "text1": {
     "type": "RichText",
     "id": "f_a8b785a6-18e7-435f-bc40-b50253868b83",
     "defaultValue": false,
     "value": "<div class=\"s-rich-text-wrapper\" style=\"display: block; \"><h4 class=\" s-rich-text-wrapper font-size-tag-header-four s-text-font-size-over-default\" style=\"font-size: 20px;\"><span style=\"color: #000000;\">Votre rôle chez Spice Events</span></h4></div>",
     "backupValue": null,
     "version": 1,
     "lineAlignment": {
      "firstLineTextAlign": null,
      "lastLineTextAlign": null
     },
     "defaultDataProcessed": true
    },
    "text2": {
     "type": "RichText",
     "id": "f_653bd37a-9c49-4521-b37a-558eae5bc897",
     "defaultValue": false,
     "value": "<div class=\"s-rich-text-wrapper\" style=\"display: block; \"><p class=\" font-size-tag-paragraph s-text-font-size-over-default s-rich-text-wrapper\" style=\"text-align: left; font-size: 18px;\"><span><u>Vos missions principales :</u></span></p><ul><li style=\"text-align: justify;\">Gérer et animer la piste de danse pendant environ 4h</li><li style=\"text-align: justify;\">Adapter la musique en temps réel selon l’ambiance et le public</li><li style=\"text-align: justify;\">Être force de proposition pour les moments clés (entrée, ouverture de bal, surprises, transitions)</li><li style=\"text-align: justify;\">Assurer une présentation professionnelle et commerciale</li><li style=\"text-align: justify;\">Participer aux rendez-vous clients en visio (ponctuellement)</li><li style=\"text-align: justify;\">Gérer le timing de la soirée en lien avec les autres prestataires (traiteur, photo, vidéo…)</li><li style=\"text-align: justify;\">Aider au montage et démontage du matériel, en collaboration avec un technicien</li></ul><p style=\"text-align: justify;\"><span style=\"display: inline-block\"></span></p><p style=\"text-align: justify;\"><span style=\"display: inline-block\"></span></p><p style=\"text-align: center;\"><span style=\"color: #000000;\"><strong>Pourquoi rejoindre Spice Events ?</strong></span></p><p style=\"text-align: center;\"><span style=\"display: inline-block\"></span></p><p style=\"text-align: justify;\"><span style=\"color: #000000;\">Chez Spice Events, nous défendons une approche humaine et qualitative du métier. Chaque événement est préparé avec soin, anticipation et rigueur, jamais laissé au hasard. Vous rejoignez une équipe passionnée et bienveillante, attachée au travail collectif et à l’exigence du détail. Nos prestations sont valorisantes, soutenues par du matériel professionnel performant, et s’inscrivent dans une vision moderne et engagée du DJ événementiel.</span></p></div>",
     "backupValue": null,
     "version": 1,
     "lineAlignment": {
      "firstLineTextAlign": "left",
      "lastLineTextAlign": "justify"
     },
     "defaultDataProcessed": true
    },
