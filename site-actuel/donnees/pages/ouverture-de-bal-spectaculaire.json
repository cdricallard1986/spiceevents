               "value": "40"
              },
              {
               "type": "BlockComponentItem",
               "id": "f_42c24989-04f6-4548-a3bf-ade9c2d988b3",
               "defaultValue": null,
               "name": "context",
               "components": {
                "text1": {
                 "type": "RichText",
                 "id": "f_224a9e3e-92d2-4241-a908-1e5ec2c74c36",
                 "defaultValue": false,
                 "alignment": "justify",
                 "value": "<div class=\"s-rich-text-wrapper\" style=\"display: block; \"><h3 class=\" s-rich-text-wrapper font-size-tag-header-three s-text-font-size-over-default\" style=\"text-align: justify; font-size: 24px;\"><span style=\"color: #000000;\">Parce que votre ouverture de bal marque le début de la fête, Spice Events vous aide à en faire un moment unique, poétique et grandiose. Grâce à nos effets spéciaux scéniques, nous créons une atmosphère digne d’un film — un décor féérique où chaque regard est captivé, chaque émotion amplifiée. Laissez la magie opérer et vivez une entrée de bal qui restera gravée dans les mémoires.</span></h3></div>",
                 "backupValue": null,
                 "version": 1,
                 "defaultDataProcessed": true
                }
               }
